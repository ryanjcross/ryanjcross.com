---
import resume from "../data/resume-text.json";
---
<div class="selectable-resume" role="document" aria-label="Ryan Cross resume">
  <img class="resume-image" src={`/images/ryan-cross-resume.png?v=${resume.revision}`} alt="" aria-hidden="true" draggable="false" />
  <svg class="resume-text-layer" viewBox={`0 0 ${resume.width} ${resume.height}`} xmlns="http://www.w3.org/2000/svg" aria-label="Selectable resume text">
    <text dominant-baseline="text-before-edge">{resume.words.map((word) => (
      <tspan x={word.x} y={word.y} font-size={word.size} textLength={word.width} lengthAdjust="spacingAndGlyphs" >{word.text}{" "}</tspan>
    ))}</text>
  </svg>
</div>
<style>
  .selectable-resume{position:relative;background:white;isolation:isolate}
  .selectable-resume .resume-image{display:block;width:100%;height:auto;user-select:none;pointer-events:none}
  .resume-text-layer{position:absolute;inset:0;width:100%;height:100%;overflow:visible;user-select:text;-webkit-user-select:text;cursor:text}
  .resume-text-layer text{fill:transparent;font-family:Arial,sans-serif;white-space:pre}
  .resume-text-layer text::selection{fill:transparent;background:rgba(64,133,220,.35)}
</style>
