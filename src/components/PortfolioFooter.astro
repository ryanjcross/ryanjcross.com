---
const { blue = false } = Astro.props;
---
<footer class:list={["contact-footer", { "blue-footer": blue }]}><div class="contact-content"><h2>get in touch</h2><div class="contact-links"><a href="mailto:ryanc31415@gmail.com" aria-label="Email Ryan Cross"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 6 9 7 9-7"/></svg></a><a href="https://www.linkedin.com/in/ryan-cross-/" target="_blank" rel="noreferrer" aria-label="LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96C2 21.32 2.69 22 3.55 22h16.9c.86 0 1.55-.68 1.55-1.52V3.52C22 2.68 21.31 2 20.45 2ZM7.93 18.75H4.98V9.2h2.95v9.55ZM6.45 7.9a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42Zm12.3 10.85H15.8V14.1c0-1.11-.02-2.54-1.55-2.54-1.55 0-1.79 1.21-1.79 2.46v4.73H9.51V9.2h2.83v1.3h.04c.39-.74 1.36-1.52 2.79-1.52 2.98 0 3.58 1.96 3.58 4.51v5.26Z"/></svg></a><a href="https://www.instagram.com/ryancross___/" target="_blank" rel="noreferrer" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a></div><p class="contact-copyright">© 2026 Ryan Cross</p></div></footer>
<style>

.contact-footer{box-sizing:border-box;position:relative;display:flex;flex-direction:column;align-items:center;gap:36px;padding:58px 5% 32px;background:#f7f6f2;color:#202e32;font:400 17px/1.7 Poppins,sans-serif}
.contact-footer.blue-footer{background:#253551;color:#f7f6f2}
.contact-footer .contact-content{text-align:center}
.contact-footer h2{position:static;margin:0 0 24px;font:500 32px/1.4 Manrope,sans-serif;letter-spacing:-.8px;color:inherit}
.contact-footer .contact-links{display:flex;align-items:center;justify-content:center;gap:24px;flex-wrap:wrap}
.contact-footer a{display:inline-flex;align-items:center;color:inherit;text-decoration:none;transition:color .2s}
.contact-footer svg{width:27px;height:27px}
.contact-footer a:hover{color:#536878}
.contact-footer a:focus-visible{outline:2px solid #597669;outline-offset:6px}
.contact-footer .contact-copyright{align-self:flex-end;margin:0;font:500 32px/1.4 Manrope,sans-serif;letter-spacing:-.8px;color:inherit}
@media(max-width:760px){.contact-footer h2,.contact-footer .contact-copyright{font-size:28px}.contact-footer{padding:42px 5% 28px;font-size:16px}.contact-footer .contact-links{gap:20px}}
.contact-footer{padding-top:78px;padding-bottom:24px;display:block}
.contact-footer .contact-content{width:100%;display:grid;grid-template-columns:1fr auto;align-items:center;gap:0 28px;text-align:left}
.contact-footer h2{grid-column:1/-1;margin-bottom:18px;font-size:25px}
.contact-footer .contact-links{justify-content:flex-start;gap:22px;font-size:15px}
.contact-footer .contact-copyright{align-self:center;justify-self:end;font:400 13px/1.7 Poppins,sans-serif;letter-spacing:0}
.contact-footer svg{width:23px;height:23px}
@media(max-width:600px){.contact-footer{padding-top:58px}.contact-footer .contact-content{gap:18px 12px;grid-template-columns:1fr auto}.contact-footer h2{margin:0;font-size:24px}.contact-footer .contact-links{gap:14px;font-size:13px}.contact-footer .contact-copyright{font-size:10px}.contact-footer svg{width:20px;height:20px}}
@media(max-width:400px){.contact-footer .contact-content{grid-template-columns:1fr}.contact-footer .contact-links{grid-column:1}.contact-footer .contact-copyright{grid-column:1;justify-self:end}}
.contact-footer .contact-content{grid-template-columns:1fr auto 1fr;text-align:center}
.contact-footer h2{grid-column:2}
.contact-footer .contact-links{grid-column:2;justify-content:center}
.contact-footer .contact-copyright{grid-column:3;justify-self:end}
@media(max-width:760px){.contact-footer .contact-content{grid-template-columns:1fr}.contact-footer h2,.contact-footer .contact-links{grid-column:1}.contact-footer .contact-copyright{grid-column:1;justify-self:end}}
.contact-footer{padding-top:28px;padding-bottom:24px}
.contact-footer .contact-links{gap:20px}
.contact-footer .contact-links a{justify-content:center;min-width:44px;min-height:44px}
.contact-footer svg{width:27px;height:27px}
@media(max-width:760px){.contact-footer{padding-top:24px}.contact-footer svg{width:27px;height:27px}}
</style>
