---
import "../styles/theme.css";
---
<script is:inline>
  (() => {
    let saved = null;
    try { saved = localStorage.getItem('portfolio-light-switch'); } catch {}
    const dark = saved === 'off' || (saved !== 'on' && window.matchMedia('(prefers-color-scheme: dark)').matches);
    document.documentElement.dataset.theme = dark ? 'dark' : 'light';
  })();
</script>
<button class="light-switch" type="button" role="switch" aria-checked="true" aria-label="Light mode" title="Switch between light and dark mode">
  <span class="switch-sun" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4" fill="currentColor"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg></span>
  <span class="switch-moon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" fill="currentColor"/><path d="m18 4 .8 2.1 2.2.1-1.7 1.4.6 2.2L18 8.5l-1.9 1.3.6-2.2L15 6.2l2.2-.1Z" fill="currentColor"/></svg></span>
  <span class="switch-thumb" aria-hidden="true"></span>
</button>
<style>
  .light-switch{position:absolute;z-index:30;top:var(--light-switch-top,465px);right:16px;display:block;width:92px;height:46px;padding:0;border:1px solid #dadcd8;border-radius:999px;background:#e8e9e5;box-shadow:inset 2px 3px 5px #202e3238,inset -2px -2px 4px #fff;cursor:pointer;touch-action:manipulation;-webkit-tap-highlight-color:transparent;transition:background .3s,border-color .3s}
  .switch-sun,.switch-moon{position:absolute;top:11px;width:24px;height:24px;color:#e9b63b;transition:opacity .25s}
  .switch-sun{left:12px}.switch-moon{right:11px;opacity:0}
  .light-switch svg{display:block;width:100%;height:100%}
  .switch-thumb{position:absolute;left:4px;top:3px;width:38px;height:38px;border-radius:50%;background:linear-gradient(145deg,#fffffc,#dedfd9);box-shadow:inset 1px 1px 2px #fff,2px 3px 5px #0003;transform:translateX(44px);transition:transform .35s cubic-bezier(.4,0,.2,1)}
  .light-switch[aria-checked="false"]{background:#303841;border-color:#444d56;box-shadow:inset 2px 3px 5px #0007,inset -1px -1px 3px #ffffff26}
  .light-switch[aria-checked="false"] .switch-thumb{transform:translateX(0)}
  .light-switch[aria-checked="false"] .switch-sun{opacity:0}
  .light-switch[aria-checked="false"] .switch-moon{opacity:1}
  .light-switch:focus-visible{outline:2px solid #536878;outline-offset:5px}
  @media(max-width:760px){.light-switch{width:80px;height:42px;top:var(--light-switch-top,575px);right:14px}.switch-thumb{width:34px;height:34px;transform:translateX(36px)}.switch-sun,.switch-moon{top:9px;width:22px;height:22px}.switch-sun{left:10px}.switch-moon{right:9px}}
  @media(prefers-reduced-motion:reduce){.light-switch,.switch-thumb,.switch-sun,.switch-moon{transition:none}}
</style>
<script>
  const lightSwitch = document.querySelector<HTMLButtonElement>('.light-switch');
  if (lightSwitch) {
    const storageKey = 'portfolio-light-switch';
    const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
    let saved: string | null = null;
    try { saved = localStorage.getItem(storageKey); } catch {}
    let hasManualPreference = saved === 'on' || saved === 'off';
    let isOn = hasManualPreference ? saved === 'on' : !systemTheme.matches;
    const render = () => {
      document.documentElement.dataset.theme = isOn ? 'light' : 'dark';
      lightSwitch.setAttribute('aria-checked', String(isOn));
      lightSwitch.title = isOn ? 'Switch to dark mode' : 'Switch to light mode';
    };
    render();
    lightSwitch.addEventListener('click', () => {
      hasManualPreference = true;
      isOn = !isOn;
      render();
      try { localStorage.setItem(storageKey, isOn ? 'on' : 'off'); } catch {}
    });
    systemTheme.addEventListener('change', () => {
      if (!hasManualPreference) {
        isOn = !systemTheme.matches;
        render();
      }
    });
    window.addEventListener('storage', (event) => {
      if (event.key !== storageKey && event.key !== null) return;
      const preference = event.key === null ? null : event.newValue;
      hasManualPreference = preference === 'on' || preference === 'off';
      isOn = hasManualPreference ? preference === 'on' : !systemTheme.matches;
      render();
    });
    const positionSwitch = () => {
      const intro = document.querySelector<HTMLElement>('.portfolio-main .intro');
      const positionKey = `portfolio-switch-position-${window.innerWidth}`;
      let top: number | undefined;
      if (intro) {
        top = intro.getBoundingClientRect().bottom + window.scrollY - lightSwitch.offsetHeight - 8;
        try { sessionStorage.setItem(positionKey, String(top)); } catch {}
      } else {
        try {
          const saved = sessionStorage.getItem(positionKey);
          if (saved) top = Number(saved);
        } catch {}
      }
      if (top !== undefined && Number.isFinite(top)) {
        lightSwitch.style.setProperty('--light-switch-top', `${Math.max(150, top)}px`);
      }
    };
    positionSwitch();
    window.addEventListener('resize', positionSwitch);
    window.addEventListener('load', positionSwitch, { once: true });
  }
</script>
