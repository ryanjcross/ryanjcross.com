---
import "../styles/theme.css";
---
<script is:inline>
  try { document.documentElement.dataset.theme = localStorage.getItem('portfolio-light-switch') === 'off' ? 'dark' : 'light'; } catch {}
</script>
<button class="light-switch" type="button" role="switch" aria-checked="true" aria-label="Light mode" title="Switch between light and dark mode">
  <svg viewBox="0 0 72 114" width="72" height="114" aria-hidden="true">
    <defs>
      <linearGradient id="switch-plate-face" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#fcfbf7"/><stop offset="1" stop-color="#d8d8d2"/></linearGradient>
      <linearGradient id="switch-rocker-face" x1="0" y1="0" x2="0.7" y2="1"><stop stop-color="#fffefa"/><stop offset="1" stop-color="#deded7"/></linearGradient>
    </defs>
    <g stroke="#202629" stroke-width="1.7" stroke-linejoin="round">
      <path d="M12 11 55 3Q61 2 65 9L67 96Q67 102 60 104L17 112Q6 113 5 104L4 22Q4 13 12 11Z" fill="#aeb1ad"/>
      <path d="M17 15 61 7Q67 7 67 14L68 96Q68 102 61 104L19 112Q11 113 11 105L10 26Q10 17 17 15Z" fill="url(#switch-plate-face)"/>
      <path d="m5 18 6 6M7 108l7 1M12 11l5 4" fill="none"/>
      <path d="m25 37 27-5 1 48-27 5Z" fill="#333a3b"/>
      <g class="light-switch-rocker">
        <path class="rocker-top" d="m25 38 20-4 9 8-22 5Z" fill="#eeeeea"/>
        <path d="m25 38 7 9 1 38-7-6Z" fill="#9c9f9b"/>
        <path d="m32 47 22-5-1 38-20 5Z" fill="url(#switch-rocker-face)"/>
        <path d="m33 85 20-5-4 4-17 4Z" fill="#b7bab4"/>
      </g>
      <g fill="#b8bcb6" stroke-width="1.3"><circle cx="38" cy="23" r="3.1"/><path d="m36.3 21.5 3.4 3M36.4 24.5l3.2-3"/><circle cx="39" cy="98" r="3.1"/><path d="m37.3 96.5 3.4 3M37.4 99.5l3.2-3"/></g>
    </g>
  </svg>
</button>
<style>
  .light-switch{position:absolute;z-index:30;top:var(--light-switch-top,415px);right:16px;display:block;width:62px;height:98px;padding:0;border:0;background:transparent;cursor:pointer;filter:drop-shadow(2px 4px 3px #202e3228);touch-action:manipulation;-webkit-tap-highlight-color:transparent}
  .light-switch svg{display:block;width:100%;height:100%;overflow:visible}
  .light-switch-rocker{transform:translateY(-3px);transition:transform .2s ease}
  .light-switch[aria-checked="false"] .light-switch-rocker{transform:translateY(3px)}
  .rocker-top{transition:fill .2s}
  .light-switch[aria-checked="false"] .rocker-top{fill:#aeb2ac}
  .light-switch:focus-visible{outline:2px solid #536878;outline-offset:5px;border-radius:5px}
  @media(max-width:760px){.light-switch{width:48px;height:76px;top:var(--light-switch-top,540px);right:14px}}
  @media(prefers-reduced-motion:reduce){.light-switch-rocker,.rocker-top{transition:none}}
</style>
<script>
  const lightSwitch = document.querySelector<HTMLButtonElement>('.light-switch');
  if (lightSwitch) {
    const storageKey = 'portfolio-light-switch';
    let isOn = true;
    try { isOn = localStorage.getItem(storageKey) !== 'off'; } catch {}
    const render = () => {
      document.documentElement.dataset.theme = isOn ? 'light' : 'dark';
      lightSwitch.setAttribute('aria-checked', String(isOn));
      lightSwitch.title = isOn ? 'Switch to dark mode' : 'Switch to light mode';
    };
    render();
    lightSwitch.addEventListener('click', () => {
      isOn = !isOn;
      render();
      try { localStorage.setItem(storageKey, isOn ? 'on' : 'off'); } catch {}
    });
    const positionSwitch = () => {
      const intro = document.querySelector<HTMLElement>('.portfolio-main .intro');
      const positionKey = `portfolio-switch-position-${window.innerWidth}`;
      let top: number | undefined;
      if (intro) {
        top = intro.getBoundingClientRect().bottom + window.scrollY - lightSwitch.offsetHeight - 16;
        try { sessionStorage.setItem(positionKey, String(top)); } catch {}
      } else {
        try {
          const saved = sessionStorage.getItem(positionKey);
          if (saved) top = Number(saved);
        } catch {}
      }
      if (top !== undefined && Number.isFinite(top)) {
        lightSwitch.style.setProperty('--light-switch-top', `${Math.max(150, top)}px`);
      }
    };
    positionSwitch();
    window.addEventListener('resize', positionSwitch);
    window.addEventListener('load', positionSwitch, { once: true });
  }
</script>
