---
import LightSwitch from "./LightSwitch.astro";
const { active = "projects", overlay = false } = Astro.props;
---
<style>
@import url("https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600&family=Poppins:wght@400;500&display=swap");
.portfolio-header{box-sizing:border-box;position:relative;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;min-height:108px;padding:32px 5%;background:#f7f6f2;color:#202e32;border:0;font:400 17px/1.7 Poppins,sans-serif}
.portfolio-header a{color:inherit;text-decoration:none}
.portfolio-header .brand{font:500 32px/1.4 Manrope,sans-serif;letter-spacing:-.8px;white-space:nowrap;justify-self:start}
.portfolio-header nav{display:flex;grid-column:2;justify-content:center;gap:34px}
.portfolio-header nav a{font:400 17px/1.7 Poppins,sans-serif;color:#6a7373}
.portfolio-header nav a:hover,.portfolio-header nav a[aria-current]{color:#203d32}
.portfolio-header nav a::after{display:none}
.portfolio-header .social-links{display:flex;grid-column:3;justify-self:end;gap:19px;align-items:center}
.portfolio-header .social-links a{display:flex;transition:color .2s}
.portfolio-header .social-links a:hover,.portfolio-header .social-links a:focus-visible{color:#536878}
.portfolio-header svg{width:27px;height:27px}
.portfolio-header a:focus-visible{outline:2px solid #597669;outline-offset:6px}
@media(max-width:760px){.portfolio-header{display:flex;flex-wrap:wrap;gap:27px;padding:24px 5% 18px}.portfolio-header .brand{font-size:28px}.portfolio-header nav{width:100%;gap:25px}.portfolio-header .social-links{position:absolute;right:5%;top:29px}}
@media(max-width:520px){.portfolio-header nav a{font-size:16px}}
.portfolio-header.banner-overlay{position:absolute;inset:0 0 auto;z-index:10;background:transparent;color:#f7f6f2;text-shadow:0 1px 8px #0008}
.portfolio-header.banner-overlay nav a{color:#f7f6f2}
.portfolio-header.banner-overlay nav a:hover,.portfolio-header.banner-overlay nav a[aria-current]{color:#fff}
.portfolio-header.banner-overlay a:focus-visible{outline-color:#fff}
.portfolio-header.banner-overlay .social-links a:hover,.portfolio-header.banner-overlay .social-links a:focus-visible{color:#536878}
</style>
<header class:list={["portfolio-header", { "banner-overlay": overlay }]}><a class="brand" href="/">Ryan Cross</a><nav aria-label="Main navigation"><a href="/" aria-current={active === "projects" ? "page" : undefined}>portfolio</a><a href="/resume" aria-current={active === "resume" ? "page" : undefined}>resume</a><a href="/about" aria-current={active === "about" ? "page" : undefined}>about</a></nav><div class="social-links"><a href="mailto:ryanc31415@gmail.com" aria-label="Email Ryan Cross"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 6 9 7 9-7"/></svg></a><a href="https://www.linkedin.com/in/ryan-cross-/" target="_blank" rel="noreferrer" aria-label="LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96C2 21.32 2.69 22 3.55 22h16.9c.86 0 1.55-.68 1.55-1.52V3.52C22 2.68 21.31 2 20.45 2ZM7.93 18.75H4.98V9.2h2.95v9.55ZM6.45 7.9a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42Zm12.3 10.85H15.8V14.1c0-1.11-.02-2.54-1.55-2.54-1.55 0-1.79 1.21-1.79 2.46v4.73H9.51V9.2h2.83v1.3h.04c.39-.74 1.36-1.52 2.79-1.52 2.98 0 3.58 1.96 3.58 4.51v5.26Z"/></svg></a><a href="https://www.instagram.com/ryancross___/" target="_blank" rel="noreferrer" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a></div></header>
<LightSwitch/>
