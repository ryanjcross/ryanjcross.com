<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><title>Projects | Ryan Cross</title></head><body><header class="site-header"><a href="/" aria-label="Home"><span class="brand-mark"><b>R</b><i>C</i></span></a><nav aria-label="Primary navigation"><a href="/">Home</a><a href="/projects" aria-current="page">Projects</a><a href="/resume">Resume</a><a href="/about">About</a><a href="/contact">Contact</a></nav></header><main class="page page-heading"><h1>Projects</h1><div class="project-grid">{projects.map((project)=><a class={`project-card ${project.accent}`} href={project.href}><div class="project-image" aria-hidden="true"><span>{project.number}</span></div><h3>{project.title}</h3><p class="eyebrow project-description">{project.type}</p><span class="project-link">View project →</span></a>)}</div></main><footer class="footer site-footer"><div></div><div class="footer-socials"><a href="https://www.linkedin.com/in/ryan-cross-/" target="_blank" rel="noreferrer"><span class="footer-linkedin-logo">in</span> LinkedIn</a><a href="mailto:ryanc31415@gmail.com">ryanc31415@gmail.com</a></div><p>© {new Date().getFullYear()} Ryan Cross</p></footer></body></html>
