---
import PortfolioFooter from "../components/PortfolioFooter.astro";
import PortfolioHeader from "../components/PortfolioHeader.astro";
import CloudflareAnalytics from "../components/CloudflareAnalytics.astro";
import "../styles/portfolio.css";
const nameWords = [
  [
    { letter: "r", photo: 7, position: "53% 100%", size: "auto 115%" },
    { letter: "y", photo: 6, position: "48% 100%", size: "auto 150%" },
    { letter: "a", photo: 2, position: "50% 36%", size: "cover" },
    { letter: "n", photo: 5, position: "0% 75%", size: "133.333% auto" },
  ],
];
---
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>About | Ryan Cross</title><link rel="icon" href="/favicon.svg"/></head>
  <body>
    <PortfolioHeader active="about"/>
    <main class="about-main">
      <h1 class="photo-name" aria-label="ryan">
        {nameWords.map(word => <span class="photo-name-word" aria-hidden="true">{word.map(({ letter, photo, position, size }) => <span class="photo-name-letter" style={`background-image:url('/images/about-name-${photo}.jpg');background-position:${position};background-size:${size}`}><span class="photo-name-character">{letter}</span></span>)}</span>)}
      </h1>
      <div class="about-layout">
        <div class="about-copy">
          <h2 class="about-greeting">Hi there,</h2>
          <p>my name is Ryan and I am so glad you found my portfolio!</p>
          <p><strong>Academia:</strong> In the spring of 2027, I will earn my M.S. degree in Aerospace Engineering with a focus in Fluids, Structures, and Materials from CU Boulder. During my time in undergrad, I participated in the Engineering Honors Program, various student clubs, and earned my Certificate in Engineering Leadership.</p>
          <p><strong>Career:</strong> My pursuit to become an aerospace engineer developed from two sources: an awesome movie called <em>Hidden Figures</em>, and my first visit to the Steven F. Udvar-Hazy Center&mdash;my favorite air and space museum. Since then, I have taken on a variety of internship and research opportunities to expand my technical abilities and explore where my aerospace interests lie.</p>
          <p><strong>Hobbies:</strong> I enjoy staying active through running, hiking, swimming, skiing, and playing Ultimate Frisbee. With my free time, I am learning the guitar, watching movies, and going on walks. Every morning I love to make an espresso, experimenting with different beans, flavors, and latte art.</p>
        </div>
        <div class="about-photos">
          <img src="/images/about-museum-optimized.jpg" alt="Ryan at an air and space museum surrounded by aircraft" width="5712" height="4284"/>
          <img src="/images/about-hike-optimized.jpg" alt="Ryan hiking above a mountain lake" width="6048" height="4011" loading="lazy"/>
        </div>
      </div>
      <section class="about-contact" aria-labelledby="about-contact-title">
        <h2 id="about-contact-title">contact me!</h2>
        <form id="about-contact-form" action="https://formsubmit.co/ryanc31415@gmail.com" method="POST">
          <input type="hidden" name="_subject" value="New portfolio message" />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="_url" value="https://ryanjcross.com/about/" />
          <input type="text" name="_honey" class="contact-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="about-contact-fields">
            <label for="contact-name">name<input id="contact-name" name="name" autocomplete="name" required /></label>
            <label for="contact-email">email<input id="contact-email" name="email" type="email" autocomplete="email" required /></label>
          </div>
          <label for="contact-message">message<textarea id="contact-message" name="message" rows="5" required></textarea></label>
          <div class="about-contact-actions"><button type="submit">send</button><p id="contact-status" role="status" aria-live="polite"></p></div>
        </form>
      </section>
    </main>
    <script>
      const panels = [...document.querySelectorAll<HTMLElement>('.photo-name-letter')];
      const originalPhotos = [
        { src: '/images/about-name-7.jpg', position: '53% 100%', size: 'auto 115%' },
        { src: '/images/about-name-6.jpg', position: '48% 100%', size: 'auto 150%' },
        { src: '/images/about-name-2.jpg', position: '50% 36%', size: 'cover' },
        { src: '/images/about-name-5.jpg', position: '0% 75%', size: '133.333% auto' },
      ];
      const photos = [
        { src: '/images/about-rotation-1.jpg', position: '50% 70%', size: 'auto 125%' },
        { src: '/images/about-rotation-2.jpg', position: '72% 50%', size: 'cover' },
        { src: '/images/about-rotation-3.jpg', position: '70% 100%', size: 'auto 125%' },
        { src: '/images/about-rotation-4.jpg', position: '48% 100%', size: 'auto 125%' },
        { src: '/images/about-rotation-5.jpg', position: '50% 100%', size: 'auto 180%' },
        { src: '/images/about-rotation-6.jpg', position: '100% 50%', size: 'cover' },
        ...originalPhotos,
      ];
      const displayed = new Map(panels.map((panel, index) => [panel, originalPhotos[index].src]));
      const seen = new Set(displayed.values());
      let changing = false;
      window.setInterval(async () => {
        if (document.hidden || changing || panels.length === 0) return;
        changing = true;
        const panel = panels[Math.floor(Math.random() * panels.length)];
        let available = photos.filter(photo => !seen.has(photo.src) && ![...displayed.values()].includes(photo.src));
        if (available.length === 0) {
          seen.clear();
          displayed.forEach(src => seen.add(src));
          available = photos.filter(photo => !seen.has(photo.src));
        }
        const photo = available[Math.floor(Math.random() * available.length)];
        try {
          const image = new Image();
          image.src = photo.src;
          await image.decode();
          if (document.hidden || !panel.isConnected) return;
          const overlay = document.createElement('span');
          overlay.className = 'photo-name-replacement';
          overlay.style.backgroundImage = `url('${photo.src}')`;
          overlay.style.backgroundPosition = photo.position;
          overlay.style.backgroundSize = photo.size;
          panel.append(overlay);
          await overlay.animate([{ opacity: 0 }, { opacity: 1 }], {
            duration: matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 1200,
            easing: 'ease-in-out',
            fill: 'forwards',
          }).finished;
          panel.style.backgroundImage = overlay.style.backgroundImage;
          panel.style.backgroundPosition = photo.position;
          panel.style.backgroundSize = photo.size;
          displayed.set(panel, photo.src);
          seen.add(photo.src);
          overlay.remove();
        } catch {
          // Keep the current photo if a replacement cannot load.
        } finally {
          changing = false;
        }
      }, 10000);

      document.querySelector('#about-contact-form')?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const form = event.currentTarget as HTMLFormElement;
        const data = new FormData(form);
        const button = form.querySelector('button') as HTMLButtonElement;
        const status = document.querySelector('#contact-status') as HTMLParagraphElement;
        if (button.disabled) return;
        button.disabled = true;
        button.textContent = 'sending…';
        status.textContent = '';
        form.setAttribute('aria-busy', 'true');
        try {
          const response = await fetch('https://formsubmit.co/ajax/ryanc31415@gmail.com', {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: data,
            signal: AbortSignal.timeout(20000),
          });
          const result = await response.json();
          if (!response.ok || (result.success !== true && result.success !== 'true')) throw new Error('Submission failed');
          status.textContent = 'Thanks! Your message has been sent.';
          form.reset();
        } catch {
          status.textContent = 'Your message could not be sent. Please try again or email ryanc31415@gmail.com.';
        } finally {
          button.disabled = false;
          button.textContent = 'send';
          form.removeAttribute('aria-busy');
        }
      });
    </script>
    <PortfolioFooter/>
    <CloudflareAnalytics/>
  </body>
</html>
