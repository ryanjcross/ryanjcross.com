---
import "../styles/site.css";
import "../styles/refinements.css";
import "../styles/footer.css";
import "../styles/nav-order.css";
import "../styles/page-adjustments.css";
import CloudflareAnalytics from "../components/CloudflareAnalytics.astro";
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><title>About | Ryan Cross</title></head><body><header class="site-header"><a href="/" aria-label="Home"><span class="brand-mark"><b>R</b><i>C</i></span></a><nav aria-label="Primary navigation"><a href="/">Home</a><a href="/projects">Projects</a><a href="/resume">Resume</a><a href="/about" aria-current="page">About</a><a href="/contact">Contact</a></nav></header><main class="page page-heading about-page"><h1>About me</h1><div class="about-layout"><div class="copy about-copy"><p>I’m completing my aerospace engineering degree at the University of Colorado Boulder. My experience includes a systems engineering internship at Sierra Space and a test engineering internship at Kairos Power.</p><p>Different domains, same motivation: understand the system, ask the useful question, and build evidence strong enough to move forward.</p></div><div class="about-photo-stack" aria-label="Photos from Ryan's travels and interests"><figure><img src="/images/about-skiing.jpg" alt="Ryan skiing in a snowy forest" loading="lazy" decoding="async" /></figure><figure><img src="/images/about-chicago-river.jpg" alt="Ryan beside the Chicago River" loading="lazy" decoding="async" /></figure><figure><img src="/images/about-discovery.jpg" alt="Ryan at the Smithsonian with Space Shuttle Discovery" loading="lazy" decoding="async" /></figure><figure><img src="/images/about-muir-woods.jpg" alt="Ryan visiting Muir Woods National Monument" loading="lazy" decoding="async" /></figure></div></div></main><footer class="footer site-footer"><div></div><div class="footer-socials"><a href="https://www.linkedin.com/in/ryan-cross-/" target="_blank" rel="noreferrer"><span class="footer-linkedin-logo">in</span> LinkedIn</a><a href="mailto:ryanc31415@gmail.com">ryanc31415@gmail.com</a></div><p>© {new Date().getFullYear()} Ryan Cross</p></footer><CloudflareAnalytics /></body></html>

<style>
  .about-layout{display:grid;grid-template-columns:minmax(280px,.82fr) minmax(420px,1.18fr);gap:clamp(52px,8vw,130px);width:min(1400px,calc(100% - 48px));margin:0 auto;padding:clamp(24px,3vw,42px) 0 clamp(70px,8vw,110px);align-items:start}
  .about-copy{width:100%;max-width:600px;padding-top:clamp(18px,4vw,60px)}
  .about-photo-stack{display:flex;flex-direction:column;width:100%;padding:20px 0 50px}
  .about-photo-stack figure{position:relative;width:min(78%,520px);aspect-ratio:4/5;margin:0;overflow:hidden;border:1px solid var(--line);border-radius:24px;background:#17201c;box-shadow:0 22px 46px rgba(0,0,0,.34)}
  .about-photo-stack figure+figure{margin-top:-64px}
  .about-photo-stack figure:nth-child(odd){align-self:flex-end}
  .about-photo-stack figure:nth-child(even){align-self:flex-start}
  .about-photo-stack figure:nth-child(1){z-index:1}.about-photo-stack figure:nth-child(2){z-index:2}.about-photo-stack figure:nth-child(3){z-index:3}.about-photo-stack figure:nth-child(4){z-index:4}
  .about-photo-stack img{display:block;width:100%;height:100%;object-fit:cover;object-position:center}
  @media(max-width:850px){.about-layout{grid-template-columns:1fr;gap:34px;width:min(100% - 36px,680px);padding-top:20px}.about-copy{max-width:none;padding-top:0}.about-photo-stack{width:min(100%,560px);margin-inline:auto}.about-photo-stack figure{width:84%;border-radius:20px}.about-photo-stack figure+figure{margin-top:-38px}}
</style>
