<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><title>Contact | Ryan Cross</title></head><body><header class="site-header"><a href="/" aria-label="Home"><span class="brand-mark"><b>R</b><i>C</i></span></a><nav aria-label="Primary navigation"><a href="/">Home</a><a href="/about">About</a><a href="/projects">Projects</a><a href="/resume">Resume</a><a href="/contact" aria-current="page">Contact</a></nav></header><main class="page contact contact-page"><h1>Contact Me</h1><div class="contact-grid"><section class="contact-form-section"><h2>Let’s Connect</h2><form id="contact-form"><label>Name<input name="name" required autocomplete="name" /></label><label>Email<input type="email" name="email" required autocomplete="email" /></label><label>Question<textarea name="question" rows="4" required></textarea></label><button class="button" type="submit">Send Message</button></form></section><section class="contact-info"><h2>Contact Info</h2><div class="socials"><a href="https://www.linkedin.com/in/ryan-cross-/" target="_blank" rel="noreferrer"><span class="linkedin-symbol">in</span> LinkedIn</a><a href="mailto:ryanc31415@gmail.com">✉ ryanc31415@gmail.com</a></div></section></div></main><footer class="footer site-footer"><div></div><div class="footer-socials"><a href="https://www.linkedin.com/in/ryan-cross-/" target="_blank" rel="noreferrer"><span class="footer-linkedin-logo">in</span> LinkedIn</a><a href="mailto:ryanc31415@gmail.com">ryanc31415@gmail.com</a></div><p>© {new Date().getFullYear()} Ryan Cross</p></footer><script>document.querySelector('#contact-form')?.addEventListener('submit',(event)=>{event.preventDefault();const form=event.currentTarget as HTMLFormElement;const data=new FormData(form);const subject=encodeURIComponent(`Portfolio message from ${data.get('name')}`);const body=encodeURIComponent(`Name: ${data.get('name')}\nEmail: ${data.get('email')}\n\n${data.get('question')}`);window.location.href=`mailto:ryanc31415@gmail.com?subject=${subject}&body=${body}`;});</script></body></html>
