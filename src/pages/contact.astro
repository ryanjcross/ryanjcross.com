---
import "../styles/site.css";
import "../styles/refinements.css";
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><title>Contact | Ryan Cross</title></head><body><header class="site-header"><a href="/" aria-label="Home"><span class="brand-mark"><b>R</b><i>C</i></span></a><nav aria-label="Primary navigation"><a href="/">Home</a><a href="/about">About</a><a href="/resume">Resume</a><a href="/projects">Projects</a><a href="/contact" aria-current="page">Contact</a></nav></header><main class="page contact"><div class="banner" aria-hidden="true"></div><div class="contact-grid"><div><p class="eyebrow">Contact</p><h1>Have a hard problem<br />worth <em>testing?</em></h1><div class="copy"><p>Send a note and I’ll get back to you soon.</p></div><div class="socials"><a href="https://www.linkedin.com/in/ryan-cross-/" target="_blank" rel="noreferrer"><span class="linkedin-symbol">in</span> LinkedIn</a><a href="mailto:ryanc31415@gmail.com">✉ ryanc31415@gmail.com</a></div></div><form id="contact-form"><label>Name<input name="name" required autocomplete="name" /></label><label>Email<input type="email" name="email" required autocomplete="email" /></label><label>Question<textarea name="question" rows="5" required></textarea></label><button class="button" type="submit">Send message <span>↗</span></button></form></div></main><footer class="footer">© {new Date().getFullYear()} Ryan Cross</footer><script>document.querySelector('#contact-form')?.addEventListener('submit',(event)=>{event.preventDefault();const form=event.currentTarget as HTMLFormElement;const data=new FormData(form);const subject=encodeURIComponent(`Portfolio message from ${data.get('name')}`);const body=encodeURIComponent(`Name: ${data.get('name')}\nEmail: ${data.get('email')}\n\n${data.get('question')}`);window.location.href=`mailto:ryanc31415@gmail.com?subject=${subject}&body=${body}`;});</script></body></html>
