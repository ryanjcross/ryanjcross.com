---
const projects = {
  "stampede-sky": { number: "01", eyebrow: "Systems Engineering Intern", title: "Sierra Space", paragraphs: ["During my systems engineering internship at Sierra Space, I supported aerospace work through structured analysis, cross-functional coordination, and clear technical communication.", "The experience strengthened my ability to understand complex systems, connect subsystem work to program-level goals, and help engineering teams make well-supported decisions."], tags: ["Systems Engineering", "Dream Chaser", "Aerospace"], accent: "teal" },
  "kairos-power": { number: "02", eyebrow: "Test Engineering Intern", title: "Kairos Power", paragraphs: ["During my test engineering internship at Kairos Power, I supported an engineering team developing advanced nuclear technology. The experience emphasized disciplined testing and the value of clear, useful data.", "Working around complex hardware strengthened the habits I bring to every project: understand the system, make testing practical, and communicate results that help a team move forward."], tags: ["Test Engineering", "Engineering", "Nuclear Technology"], accent: "blue" },
  "cu-boulder": { number: "03", eyebrow: "Aerodynamics Intern", title: "Kashmir World Foundation", paragraphs: ["During my aerodynamics internship with Kashmir World Foundation, I applied aerospace fundamentals to practical engineering questions and supported technical work through analysis and clear communication.", "The experience strengthened my ability to connect aerodynamic theory with real project constraints while contributing within an interdisciplinary team."], tags: ["Aerodynamics", "Aerospace", "Engineering"], accent: "gold" },
  "project-04": { number: "04", eyebrow: "Propulsion Lead", title: "Design Build Fly", paragraphs: ["As Propulsion Lead for Design Build Fly, I supported the development and integration of the aircraft’s propulsion system through analysis, testing, and hands-on engineering.", "The project brought together aerodynamic performance, propulsion decisions, and flight testing in a fast-moving team environment."], tags: ["Propulsion", "Aircraft Design", "Flight Test"], accent: "teal" },
};
export function getStaticPaths() {
  return ["stampede-sky", "kairos-power", "cu-boulder", "project-04"]
    .map((slug) => ({ params: { slug } }));
}
const project = projects[Astro.params.slug];
---

<!doctype html>
<html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={`${project.title} — Ryan Cross portfolio project.`} /><link rel="icon" href="/favicon.svg" /><title>{project.title} | Ryan Cross</title></head><body>
  <header class="site-header"><a href="/" aria-label="Home"><span class="brand-mark"><b>R</b><i>C</i></span></a><nav aria-label="Primary navigation"><a href="/">Home</a><a href="/projects" aria-current="page">Projects</a><a href="/resume">Resume</a><a href="/about">About</a><a href="/contact">Contact</a></nav></header>
  <main class={`${project.accent} project-${Astro.params.slug}`}>
    <a class="back" href="/projects">← Back to projects</a>
    <section class="project"><div class="project-image" role="img" aria-label={`${project.title} project image`}><div class="shape"></div><div class="line-grid"></div><span>Project image</span></div><div class="project-info"><h1>{project.title}</h1><div class="copy">{project.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div><ul>{project.tags.map((tag) => <li>{tag}</li>)}</ul></div></section>
  </main>
</body></html>

<style>
  @import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap");
  :root{--bg:#0e100f;--surface:#171a18;--ink:#f2f0e8;--muted:#a7aaa0;--line:rgba(242,240,232,.18);--teal:#6be6d3;--blue:#8ca7ff;--gold:#f1cc58}*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font-family:"DM Sans",sans-serif}a{color:inherit;text-decoration:none}.site-header{position:sticky;z-index:10;top:0;width:100%;height:74px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:0 clamp(20px,4vw,72px);background:rgba(13,15,14,.94);backdrop-filter:blur(16px);border-bottom:1px solid var(--line)}.brand-mark{position:relative;display:block;width:36px;height:34px;overflow:hidden;background:#0d0f0e;border:1px solid var(--teal)}.brand-mark b,.brand-mark i{position:absolute;top:8px;color:#e9faf5;font:800 17px/1 "DM Sans",sans-serif;font-style:normal;text-shadow:1px 1px 0 #126e67,2px 2px 0 #08453d,3px 3px 4px rgba(0,0,0,.5)}.brand-mark b{left:6px}.brand-mark i{left:16px}.site-header nav{grid-column:2;justify-self:center;display:flex;gap:clamp(15px,2.3vw,30px);font-size:14px}.site-header nav a:hover,.site-header nav a[aria-current="page"]{color:var(--teal)}main{height:calc(100svh - 74px);min-height:506px;position:relative;padding:32px clamp(24px,5vw,78px);overflow:hidden}.back{position:absolute;z-index:3;top:32px;left:clamp(24px,5vw,78px);padding:12px 16px;border:1px solid var(--line);background:#0e100fd9;font-size:12px;font-weight:600;transition:background .2s}.back:hover{background:var(--ink);color:var(--bg)}.project{height:100%;display:grid;grid-template-columns:1fr 1fr;gap:clamp(45px,8vw,140px);align-items:center}.project-image{height:min(67vh,650px);position:relative;display:grid;place-items:center;overflow:hidden;background:#26312c;border:1px solid var(--line)}.project-image span{position:relative;z-index:2;padding:9px 13px;border:1px solid var(--line);background:#0e100fcc;font-size:10px;letter-spacing:.14em;text-transform:uppercase}.shape{position:absolute;width:37%;aspect-ratio:1;border:clamp(25px,5vw,64px) solid var(--teal);border-radius:50%}.blue .shape{border:0;border-radius:0;background:var(--blue);transform:rotate(45deg)}.gold .shape{width:45%;aspect-ratio:1.8;border:0;border-radius:100% 0;background:var(--gold);transform:rotate(-25deg)}.line-grid{position:absolute;inset:0;background:repeating-linear-gradient(90deg,transparent 0 52px,rgba(242,240,232,.11) 53px 54px)}h1{margin:0;font:400 clamp(50px,7vw,96px)/.84 "Instrument Serif",serif;letter-spacing:-.06em}.copy{max-width:570px;margin:38px 0 28px}.copy p{margin:0 0 15px;color:var(--muted);font-size:clamp(15px,1.25vw,18px);line-height:1.65}ul{display:flex;flex-wrap:wrap;gap:8px;margin:0;padding:0;list-style:none}li{padding:7px 9px;border:1px solid var(--line);font-size:9px;letter-spacing:.08em;text-transform:uppercase}@media(max-width:720px){html,body{min-height:100%}.site-header{height:68px}.brand-mark{width:34px;height:32px}.brand-mark b,.brand-mark i{top:7px}.brand-mark b{left:5px}.brand-mark i{left:15px}.site-header nav{gap:10px;font-size:11px}main{height:auto;min-height:calc(100svh - 68px);overflow:visible;padding-top:100px}.project{grid-template-columns:1fr;gap:32px}.project-image{height:300px}.copy{margin:25px 0}.back{top:22px}}
  .project-kairos-power .project-image{background:url("/images/kairos-power.png") center top/cover no-repeat}.project-kairos-power .shape,.project-kairos-power .line-grid,.project-kairos-power .project-image span,.project-stampede-sky .shape,.project-stampede-sky .line-grid,.project-stampede-sky .project-image span,.project-cu-boulder .shape,.project-cu-boulder .line-grid,.project-cu-boulder .project-image span,.project-project-04 .shape,.project-project-04 .line-grid,.project-project-04 .project-image span{display:none}.project-stampede-sky .project-image{background:url("/images/sierra-space-dream-chaser.jpg") center/cover no-repeat}.project-cu-boulder .project-image{background:url("/images/kashmir-world-foundation.png") center/cover no-repeat}.project-project-04 .project-image{background:url("/images/design-build-fly-01.webp") center/cover no-repeat}
</style>
