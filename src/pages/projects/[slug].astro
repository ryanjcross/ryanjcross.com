---
const projects = {
  "stampede-sky": { number: "01", eyebrow: "Systems Engineering Intern", title: "Sierra Space", paragraphs: ["During my systems engineering internship at Sierra Space, I supported aerospace work through structured analysis, cross-functional coordination, and clear technical communication.", "The experience strengthened my ability to understand complex systems, connect subsystem work to program-level goals, and help engineering teams make well-supported decisions."], tags: ["Systems Engineering", "Dream Chaser", "Aerospace"], accent: "teal" },
  "kairos-power": { number: "02", eyebrow: "Test Engineering Intern", title: "Kairos Power", paragraphs: ["During my test engineering internship at Kairos Power, I supported an engineering team developing advanced nuclear technology. The experience emphasized disciplined testing and the value of clear, useful data.", "Working around complex hardware strengthened the habits I bring to every project: understand the system, make testing practical, and communicate results that help a team move forward."], tags: ["Test Engineering", "Engineering", "Nuclear Technology"], accent: "blue" },
  "cu-boulder": { number: "03", eyebrow: "Aerodynamics Intern", title: "Kashmir World Foundation", paragraphs: ["During my aerodynamics internship with Kashmir World Foundation, I applied aerospace fundamentals to practical engineering questions and supported technical work through analysis and clear communication.", "The experience strengthened my ability to connect aerodynamic theory with real project constraints while contributing within an interdisciplinary team."], tags: ["Aerodynamics", "Aerospace", "Engineering"], accent: "gold" },
  "project-04": { number: "04", eyebrow: "In development", title: "Project 04", paragraphs: ["A new project page reserved for upcoming portfolio work.", "Project details, imagery, and outcomes will be added here as the work develops."], tags: ["Coming Soon"], accent: "teal" },
  "project-05": { number: "05", eyebrow: "In development", title: "Project 05", paragraphs: ["A new project page reserved for upcoming portfolio work.", "Project details, imagery, and outcomes will be added here as the work develops."], tags: ["Coming Soon"], accent: "blue" },
  "project-06": { number: "06", eyebrow: "In development", title: "Project 06", paragraphs: ["A new project page reserved for upcoming portfolio work.", "Project details, imagery, and outcomes will be added here as the work develops."], tags: ["Coming Soon"], accent: "gold" },
  "project-07": { number: "07", eyebrow: "In development", title: "Project 07", paragraphs: ["A new project page reserved for upcoming portfolio work.", "Project details, imagery, and outcomes will be added here as the work develops."], tags: ["Coming Soon"], accent: "teal" },
  "project-08": { number: "08", eyebrow: "In development", title: "Project 08", paragraphs: ["A new project page reserved for upcoming portfolio work.", "Project details, imagery, and outcomes will be added here as the work develops."], tags: ["Coming Soon"], accent: "blue" },
  "project-09": { number: "09", eyebrow: "In development", title: "Project 09", paragraphs: ["A new project page reserved for upcoming portfolio work.", "Project details, imagery, and outcomes will be added here as the work develops."], tags: ["Coming Soon"], accent: "gold" },
};
export function getStaticPaths() {
  return ["stampede-sky", "kairos-power", "cu-boulder", "project-04", "project-05", "project-06", "project-07", "project-08", "project-09"]
    .map((slug) => ({ params: { slug } }));
}
const project = projects[Astro.params.slug];
---

<!doctype html>
<html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={`${project.title} — Ryan Cross portfolio project.`} /><link rel="icon" href="/favicon.svg" /><title>{project.title} | Ryan Cross</title></head><body>
  <main class={`${project.accent} project-${Astro.params.slug}`}>
    <a class="back" href="/#work">← Back to main page</a>
    <section class="project"><div class="project-image" role="img" aria-label={`Space for a ${project.title} project image`}><div class="shape"></div><div class="line-grid"></div><span>Project image</span></div><div class="project-info"><p class="eyebrow">{project.number} / {project.eyebrow}</p><h1>{project.title}</h1><div class="copy">{project.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div><ul>{project.tags.map((tag) => <li>{tag}</li>)}</ul></div></section>
  </main>
</body></html>

<style>
  @import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap");
  :root{--bg:#0e100f;--surface:#171a18;--ink:#f2f0e8;--muted:#a7aaa0;--line:rgba(242,240,232,.18);--teal:#6be6d3;--blue:#8ca7ff;--gold:#f1cc58}*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font-family:"DM Sans",sans-serif}a{color:inherit;text-decoration:none}main{height:100svh;min-height:580px;position:relative;padding:32px clamp(24px,5vw,78px);overflow:hidden}.back{position:absolute;z-index:3;top:32px;left:clamp(24px,5vw,78px);padding:12px 16px;border:1px solid var(--line);background:#0e100fd9;font-size:12px;font-weight:600;transition:background .2s}.back:hover{background:var(--ink);color:var(--bg)}.project{height:100%;display:grid;grid-template-columns:1fr 1fr;gap:clamp(45px,8vw,140px);align-items:center}.project-image{height:min(67vh,650px);position:relative;display:grid;place-items:center;overflow:hidden;background:#26312c;border:1px solid var(--line)}.project-image span{position:relative;z-index:2;padding:9px 13px;border:1px solid var(--line);background:#0e100fcc;font-size:10px;letter-spacing:.14em;text-transform:uppercase}.shape{position:absolute;width:37%;aspect-ratio:1;border:clamp(25px,5vw,64px) solid var(--teal);border-radius:50%}.blue .shape{border:0;border-radius:0;background:var(--blue);transform:rotate(45deg)}.gold .shape{width:45%;aspect-ratio:1.8;border:0;border-radius:100% 0;background:var(--gold);transform:rotate(-25deg)}.line-grid{position:absolute;inset:0;background:repeating-linear-gradient(90deg,transparent 0 52px,rgba(242,240,232,.11) 53px 54px)}.eyebrow{margin:0 0 20px;color:var(--muted);font-size:10px;font-weight:600;letter-spacing:.14em;text-transform:uppercase}h1{margin:0;font:400 clamp(72px,10vw,148px)/.78 "Instrument Serif",serif;letter-spacing:-.06em}.copy{max-width:570px;margin:38px 0 28px}.copy p{margin:0 0 15px;color:var(--muted);font-size:clamp(15px,1.25vw,18px);line-height:1.65}ul{display:flex;flex-wrap:wrap;gap:8px;margin:0;padding:0;list-style:none}li{padding:7px 9px;border:1px solid var(--line);font-size:9px;letter-spacing:.08em;text-transform:uppercase}@media(max-width:720px){html,body{min-height:100%}main{height:auto;min-height:100svh;overflow:visible;padding-top:100px}.project{grid-template-columns:1fr;gap:32px}.project-image{height:300px}.copy{margin:25px 0}.back{top:22px}}
  .project-kairos-power .project-image{background:url("/images/kairos-power.png") center top/cover no-repeat}.project-kairos-power .shape,.project-kairos-power .line-grid,.project-kairos-power .project-image span,.project-stampede-sky .shape,.project-stampede-sky .line-grid,.project-stampede-sky .project-image span,.project-cu-boulder .shape,.project-cu-boulder .line-grid,.project-cu-boulder .project-image span{display:none}.project-stampede-sky .project-image{background:url("/images/sierra-space-dream-chaser.jpg") center/cover no-repeat}.project-cu-boulder .project-image{background:url("/images/kashmir-world-foundation.png") center/cover no-repeat}
</style>
