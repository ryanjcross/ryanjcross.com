---
const projects = {
  "stampede-sky": { number: "01", eyebrow: "Senior Design · Propulsion", title: "Stampede Sky", summary: "Propulsion and integrated test work for a CU Boulder aerospace senior design team, connecting subsystem decisions with full vehicle evaluation.", tags: ["Propulsion", "Integrated Test", "Systems Engineering"], accent: "teal" },
  "kairos-power": { number: "02", eyebrow: "Industry · Test Engineering", title: "Kairos Power", summary: "A test engineering internship supporting the work of an engineering company developing advanced nuclear technology.", tags: ["Test Engineering", "Engineering", "Nuclear Technology"], accent: "blue" },
  "cu-boulder": { number: "03", eyebrow: "Education · Aerospace Engineering", title: "CU Boulder", summary: "Aerospace engineering studies at the University of Colorado Boulder, with graduation expected in 2026.", tags: ["Aerospace Engineering", "Class of 2026", "Boulder"], accent: "yellow" },
};

export function getStaticPaths() {
  return Object.entries(projects).map(([slug, project]) => ({ params: { slug }, props: { project } }));
}

const { project } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={`${project.title} — Ryan Cross portfolio project.`} />
    <link rel="icon" href="/favicon.svg" />
    <title>{project.title} | Ryan Cross</title>
  </head>
  <body>
    <main>
      <a class="back" href="/#work">← Back to main page</a>
      <section class={`project ${project.accent}`}>
        <p class="eyebrow">{project.number} / {project.eyebrow}</p>
        <h1>{project.title}</h1>
        <div class="project-image" role="img" aria-label={`Image space for ${project.title}`}>
          <div class="shape"></div><div class="lines"></div><span>Project image</span>
        </div>
        <div class="details">
          <p>{project.summary}</p>
          <ul>{project.tags.map((tag) => <li>{tag}</li>)}</ul>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  @import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap");
  :root { --paper: #f0eee8; --ink: #171914; --muted: #686b61; --teal: #126e67; --blue: #5e80ff; --yellow: #ebc83e; }
  * { box-sizing: border-box; } body { margin: 0; background: var(--paper); color: var(--ink); font-family: "DM Sans", sans-serif; } a { color: inherit; text-decoration: none; }
  main { max-width: 1320px; margin: auto; padding: 34px clamp(24px, 8vw, 130px) 100px; }
  .back { display: inline-flex; padding: 13px 18px; border: 1px solid var(--ink); font-size: 13px; font-weight: 600; transition: background .2s, color .2s; }.back:hover { background: var(--ink); color: white; }
  .project { margin-top: clamp(75px, 13vh, 150px); }.eyebrow { color: var(--muted); font-size: 11px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; }
  h1 { margin: 20px 0 50px; font: 400 clamp(76px, 13vw, 170px)/.78 "Instrument Serif", serif; letter-spacing: -.06em; }
  .project-image { position: relative; display: grid; place-items: center; height: clamp(300px, 48vw, 580px); overflow: hidden; background: #dddcd5; }.project-image span { position: relative; z-index: 2; padding: 10px 14px; background: rgba(240,238,232,.82); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; }
  .shape { position: absolute; width: 38%; aspect-ratio: 1; border: clamp(25px, 5vw, 64px) solid var(--teal); border-radius: 50%; }.blue .shape { border: 0; border-radius: 0; background: var(--blue); transform: rotate(45deg); }.yellow .shape { width: 45%; aspect-ratio: 1.8; border: 0; border-radius: 100% 0; background: var(--yellow); transform: rotate(-25deg); }.lines { position: absolute; inset: 0; background: repeating-linear-gradient(90deg, transparent 0 52px, rgba(23,25,20,.14) 53px 54px); }
  .details { display: grid; grid-template-columns: minmax(0, 650px) 1fr; gap: 50px; margin: 45px 0 0 auto; max-width: 900px; }.details > p { margin: 0; color: #454840; font-size: clamp(18px, 2vw, 25px); line-height: 1.55; }ul { display: flex; flex-wrap: wrap; align-content: start; gap: 8px; margin: 4px 0 0; padding: 0; list-style: none; }li { padding: 7px 10px; border: 1px solid #bdbcb4; font-size: 9px; letter-spacing: .08em; text-transform: uppercase; }
  @media (max-width: 700px) { main { padding-top: 24px; }.project { margin-top: 80px; }.details { grid-template-columns: 1fr; gap: 25px; } }
</style>
