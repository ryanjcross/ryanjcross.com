---
import CloudflareAnalytics from "../../components/CloudflareAnalytics.astro";

const projects = {
  "stampede-sky": {
    title: "Sierra Space",
    paragraphs: [
      "During my systems engineering internship at Sierra Space, I supported aerospace work through structured analysis, cross-functional coordination, and clear technical communication.",
      "The experience strengthened my ability to understand complex systems, connect subsystem work to program-level goals, and help engineering teams make well-supported decisions.",
    ],
    heroImage: "/images/sierra-space-dream-chaser.jpg",
    heroAlt: "Sierra Space Dream Chaser spacecraft",
    heroPosition: "center",
    image: "/images/sierra-space-dream-chaser.jpg",
    imageAlt: "Sierra Space Dream Chaser spacecraft",
    imagePosition: "center",
    secondImage: "/images/sierra-space-dream-chaser.jpg",
    secondImageAlt: "Sierra Space Dream Chaser spacecraft",
    secondImagePosition: "center",
  },
  "kairos-power": {
    title: "Kairos Power",
    paragraphs: [
      "During my test engineering internship at Kairos Power, I supported an engineering team developing advanced nuclear technology. The experience emphasized disciplined testing and the value of clear, useful data.",
      "Working around complex hardware strengthened the habits I bring to every project: understand the system, make testing practical, and communicate results that help a team move forward.",
    ],
    heroImage: "/images/kairos-power-banner.png",
    heroAlt: "Kairos Power logo and blue circular dot pattern",
    heroPosition: "center top",
    image: "/images/kairos-power.png",
    imageAlt: "Kairos Power engineering facility",
    imagePosition: "center top",
    secondImage: "/images/kairos-power.png",
    secondImageAlt: "Kairos Power engineering facility",
    secondImagePosition: "center top",
  },
  "cu-boulder": {
    title: "Kashmir World Foundation",
    paragraphs: [
      "During my aerodynamics internship with Kashmir World Foundation, I applied aerospace fundamentals to practical engineering questions and supported technical work through analysis and clear communication.",
      "The experience strengthened my ability to connect aerodynamic theory with real project constraints while contributing within an interdisciplinary team.",
    ],
    heroImage: "/images/kashmir-world-foundation-banner-bw.png",
    heroAlt: "Computational fluid dynamics visualization of airflow around an airfoil",
    heroPosition: "right center",
    image: "/images/kashmir-snow-leopard-mountain.jpg",
    imageAlt: "Snow leopard representing Kashmir World Foundation's conservation work",
    imagePosition: "center",
    secondImage: "/images/kashmir-aircraft-dimensioned.svg",
    secondImageAlt: "Aerodynamic aircraft concept for Kashmir World Foundation",
    secondImagePosition: "center",
  },
  "project-04": {
    title: "Design Build Fly",
    paragraphs: [
      "Every year, AIAA challenges students to show their creativity and technical expertise through the Design Build Fly competition. Rules are released in September with competition taking place in April.",
      "I participated on the CU team for two years, joining as a member of the avionics team, then stepping up to lead the propulsion design and implementation team.",
    ],
    heroImage: "/images/design-build-fly-aircraft-banner.webp",
    heroAlt: "Design Build Fly aircraft on the runway",
    heroPosition: "center 62%",
    image: "/images/design-build-fly-outreach.webp",
    imageAlt: "Ryan Cross explaining Design Build Fly at a student outreach event",
    imagePosition: "center 43%",
    secondImage: "/images/design-build-fly-team.webp",
    secondImageAlt: "Original Design Build Fly crew with their aircraft in Tucson",
    secondImagePosition: "center 60%",
  },
};

export function getStaticPaths() {
  return ["stampede-sky", "kairos-power", "cu-boulder", "project-04"]
    .map((slug) => ({ params: { slug } }));
}

const project = projects[Astro.params.slug];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={`${project.title} — Ryan Cross portfolio project.`} />
    <link rel="icon" href="/favicon.svg" />
    <title>{project.title} | Ryan Cross</title>
  </head>
  <body>
    <header class="site-header">
      <a href="/" aria-label="Home"><span class="brand-mark"><b>R</b><i>C</i></span></a>
      <nav aria-label="Primary navigation">
        <a href="/">Home</a><a href="/projects" aria-current="page">Projects</a><a href="/resume">Resume</a><a href="/about">About</a><a href="/contact">Contact</a>
      </nav>
    </header>

    <main class={`project-${Astro.params.slug}`} style={`--hero-position:${project.heroPosition};--project-position:${project.imagePosition};--second-position:${project.secondImagePosition}`}>
      <section class="project-hero">
        <img src={project.heroImage} alt={project.heroAlt} />
        <div class="hero-shade" aria-hidden="true"></div>
        <h1>{project.title}</h1>
      </section>
      <section class="project-content" aria-label={`${project.title} project details`}>
        {Astro.params.slug === "cu-boulder" && <p class="kwf-introduction"><strong>A nonprofit organization bringing together a global team to develop innovative solutions for wildlife conservation.</strong></p>}
        {Astro.params.slug === "cu-boulder" ? (
          <article class="project-row kwf-aircraft-row">
            <div class="project-copy"><h2>Project Eagle Ray</h2><p>The Eagle Ray aircraft is a blended-wing body UAS designed to fly over the Himalayan Mountain Range at 20,000 feet. The goal is to monitor endangered snow leopard populations, eventually offering protective solutions to poaching, habitat destruction, and dwindling populations.</p></div>
            <figure class="project-media second-media dimensioned-media">
              <img src={project.secondImage} alt={project.secondImageAlt} />
              
            </figure>
          </article>
        ) : (
          <article class="project-row">
            <div class="project-copy">
              <p>{project.paragraphs[0]}</p>
              {Astro.params.slug === "project-04" && <p>{project.paragraphs[1]}</p>}
            </div>
            <figure class="project-media"><img src={project.image} alt={project.imageAlt} /></figure>
          </article>
        )}

        {Astro.params.slug === "project-04" ? (
          <>
            <section class="dbf-story" aria-label="Design Build Fly experience by year">
              <section class="dbf-year-section" aria-labelledby="dbf-year-2025">
                <h2 class="dbf-year-title" id="dbf-year-2025">2025</h2>
                <div class="dbf-pair">
                  <figure class="year-card">
                    <div class="year-image"><img src="/images/dbf-2025-design.png" alt="2025 Design Build Fly aircraft model" /></div>
                  </figure>
                  <div class="dbf-copy">
                    <p><strong>Goal:</strong> Design an aircraft, incorporated with removeable fuel tanks, to launch an X-1 test vehicle.</p>
                    <p>When I first started, I didn’t know the first thing about RC aircraft design. Terms like <em>ESC</em> and <em>receiver</em> frightened me.</p>
                    <p>So I learned.</p>
                  </div>
                </div>
                <div class="dbf-pair">
                  <div class="dbf-copy">
                    <p>I helped configure the avionics for our first prototype—now I know that an ESC regulates the power to the motor. I developed the tail block and sections of the fuselage in OnShape—now I can navigate CAD. I fabricated components using 3D printers, laser cutters, and CNC machines, bringing design to life with CAM.</p>
                    <p>My first year on CU DBF was also my first exposure to applied, real world engineering. Following competition, I was left wanting more.</p>
                  </div>
                  <figure class="team-feature"><img src={project.secondImage} alt={project.secondImageAlt} /></figure>
                </div>
              </section>
              <section class="dbf-year-section" aria-labelledby="dbf-year-2026">
                <h2 class="dbf-year-title" id="dbf-year-2026">2026</h2>
                <div class="dbf-pair">
                  <figure class="year-card">
                    <div class="year-image"><img src="/images/dbf-2026-design.png" alt="2026 Design Build Fly aircraft model" /></div>
                  </figure>
                  <div class="dbf-copy">
                    <p><strong>Goal:</strong> Design a banner-towing bush plane fitted with rubber duck passengers and hockey puck payloads.</p>
                    <p>Becoming a leader in engineering can be daunting: one must have technical <em>and</em> interpersonal skills to succeed. In learning and applying both skillsets through DBF, the club I had developed a passion for over the last year, I became energized.</p>
                  </div>
                </div>
                <div class="dbf-pair">
                  <div class="dbf-copy">
                    <p>I improved upon a MATLAB optimization code, working with the aerodynamics team to determine the most efficient motor and propeller combination. I validated this combination with a thrust test stand, involving new members with the hands on setup and calibration. Seeing the correlation between the model and hardware test data was invaluable.</p>
                    <p>Not only was I learning, but I was able to enhance the learning of other future engineers and leaders who would continue to build the team and beyond.</p>
                  </div>
                  <figure class="team-feature"><img src="/images/dbf-team-2026.webp" alt="Design Build Fly team gathered with their aircraft" /></figure>
                </div>
              </section>
              <blockquote class="dbf-testimonial">
                <p><strong>Ryan Cross</strong>, I just wanted to add something real quick here. You mentioned that you’re “not perfect” and that you sometimes struggle to keep everyone satisfied—but honestly, I think you’re doing a great job as Propulsion Lead. The support you give, the time you put in, and the friendly environment you create make a huge difference for all of us. It’s been really reassuring and motivating to work under someone who’s approachable and genuinely cares about keeping things moving in the right direction.</p>
                <p>Leadership isn’t about being perfect; it’s about showing up, communicating, and giving your team confidence—and you’re nailing that. So kudos to you for everything you’ve done and continue to do. We appreciate it.</p>
                <footer>— Dinuka Hannadige, 2027 Test Lead</footer>
              </blockquote>
              <a class="back-to-projects" href="/projects">Back to Projects</a>
            </section>
          </>
        ) : Astro.params.slug === "cu-boulder" ? (
          <>
            <section class="snow-leopard-reveal" aria-label="Snow leopard conservation image reveal">
              <div class="snow-leopard-reveal-frame" aria-hidden="true"></div>
            </section>
            <h2 class="kwf-internship-title">Aerodynamics Internship</h2>
            <article class="project-row kwf-snow-row">
              <div class="project-copy">
                <p>To analyze the aerodynamic performance for the newest design of Eagle Ray, I cross-referenced results across multiple analysis tools, prioritizing open-source software to support KWF's nonprofit mission.</p>
                <p>I aimed to develop a CFD workflow using hardware readily accessible to my teammates—a standard laptop.</p>
              </div>
              <div class="analysis-logos" aria-label="Aerodynamic analysis tools">
                <div><span class="analysis-number">1</span><img src="/images/openvsp-logo.png" alt="OpenVSP" loading="lazy" /><p>Utilized the Vortex Lattice Method to provide a computationally efficient baseline.</p></div>
                <div><span class="analysis-number">2</span><img src="/images/openfoam-logo.png" alt="OpenFOAM" loading="lazy" /><p>Expanded the analysis to higher-fidelity CFD to capture viscous flow effects.</p></div>
                <div><span class="analysis-number">3</span><img src="/images/simscale-logo.svg" alt="SimScale" loading="lazy" /><p>Validated results through higher-resolution mesh refinement on a robust cloud-based platform.</p></div>
              </div>
            </article>
            <article class="project-row kwf-mesh-row">
              <div class="project-copy"><p>In CFD, reliable solutions come from a well-defined domain and mesh. I set up both OpenFOAM and SimScale to use steady-state RANS with the k–ω SST turbulence model. Local hardware constraints limited the OpenFOAM mesh to approximately 3.2 million cells. SimScale's cloud-based resources enabled a substantially refined 80-million-cell mesh. Near-wall inflation layers and y<sup>+</sup> verification were used to ensure adequate resolution of the boundary layer.</p></div>
              <figure class="kwf-mesh-image"><img src="/images/eagle-ray-openfoam-y-plus-v5.png" alt="Eagle Ray OpenFOAM y-plus visualization with a color scale from 0 to 30" loading="lazy" /></figure>
              <figure class="kwf-mesh-image"><img src="/images/eagle-ray-simscale-y-plus-v4.png" alt="Eagle Ray aircraft CFD surface y-plus visualization with color scale" loading="lazy" /></figure>
            </article>
          </>
        ) : project.paragraphs[1] ? (
          <article class="project-row">
            <figure class={`project-media second-media ${Astro.params.slug === "cu-boulder" ? "dimensioned-media" : ""}`}>
              <img src={project.secondImage} alt={project.secondImageAlt} />
              
            </figure>
            <div class="project-copy"><p>{project.paragraphs[1]}</p></div>
          </article>
        ) : null}
      </section>
    </main>
    <footer class="site-footer"><div></div><div class="footer-socials"><a href="https://www.linkedin.com/in/ryan-cross-/" target="_blank" rel="noreferrer"><span class="footer-linkedin-logo">in</span> LinkedIn</a><a href="mailto:ryanc31415@gmail.com">ryanc31415@gmail.com</a></div><p>© {new Date().getFullYear()} Ryan Cross</p></footer>
    <CloudflareAnalytics />
  </body>
</html>

<style>
  @import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap");

  :root{--bg:#0e100f;--surface:#171a18;--ink:#f2f0e8;--muted:#a7aaa0;--line:rgba(242,240,232,.18);--teal:#6be6d3}
  *{box-sizing:border-box}
  html,body{margin:0;background:var(--bg);color:var(--ink);font-family:"DM Sans",sans-serif}
  a{color:inherit;text-decoration:none}
  .site-header{position:sticky;z-index:10;top:0;width:100%;height:74px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:0 clamp(20px,4vw,72px);background:rgba(13,15,14,.94);backdrop-filter:blur(16px);border-bottom:1px solid var(--line)}
  .brand-mark{position:relative;display:block;width:36px;height:34px;overflow:hidden;background:#0d0f0e;border:1px solid var(--teal)}
  .brand-mark b,.brand-mark i{position:absolute;top:8px;color:#e9faf5;font:800 17px/1 "DM Sans",sans-serif;font-style:normal;text-shadow:1px 1px 0 #126e67,2px 2px 0 #08453d,3px 3px 4px rgba(0,0,0,.5)}
  .brand-mark b{left:6px}.brand-mark i{left:16px}
  .site-header nav{grid-column:2;justify-self:center;display:flex;gap:clamp(15px,2.3vw,30px);font-size:14px}
  .site-header nav a:hover,.site-header nav a[aria-current="page"]{color:var(--teal)}

  .project-hero{position:relative;height:clamp(300px,38svh,470px);overflow:hidden;background:#17201c}
  .project-hero>img{width:100%;height:100%;object-fit:cover;object-position:var(--hero-position);filter:saturate(.88)}
  .project-kairos-power .project-hero{background:#0d191b}
  .project-kairos-power .project-hero>img{object-fit:cover;object-position:center;filter:none}
  .hero-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(7,9,8,.18),rgba(7,9,8,.68))}
  h1{position:absolute;z-index:2;top:50%;left:50%;width:min(92%,1100px);margin:0;transform:translate(-50%,-50%);color:var(--ink);font:400 clamp(48px,6.5vw,92px)/.9 "Instrument Serif",serif;letter-spacing:-.055em;text-align:center;text-shadow:0 4px 26px rgba(0,0,0,.75)}
  .project-content{width:min(1200px,calc(100% - 48px));margin:0 auto;padding:8px 0 clamp(38px,5vw,72px)}
  .project-row{display:grid;grid-template-columns:minmax(0,.85fr) minmax(340px,1.15fr);gap:clamp(32px,6vw,82px);align-items:center;padding:clamp(24px,3.5vw,44px) 0}
  .project-row:first-child{padding-top:clamp(18px,2.5vw,30px)}
  .project-copy h2{margin:0 0 20px;font:400 clamp(30px,3vw,44px)/1.1 "Instrument Serif",serif;letter-spacing:-.04em}
  .project-copy p{margin:0;color:var(--ink);font-size:clamp(16px,1.35vw,20px);line-height:1.62}
  .project-copy p+p{margin-top:16px}
  .project-media{height:clamp(230px,27vw,360px);margin:0;overflow:hidden;background:#222925;border:1px solid var(--line)}
  .project-media img{width:100%;height:100%;object-fit:cover;object-position:var(--project-position)}
  .second-media img{object-position:var(--second-position)}
  .project-cu-boulder{overflow:clip}
  .project-cu-boulder .project-content{width:min(1320px,calc(100% - 32px))}
  .project-cu-boulder .kwf-aircraft-row{width:100%;margin-inline:auto;grid-template-columns:minmax(300px,1fr) minmax(0,752px)}
  .project-cu-boulder .kwf-aircraft-row .second-media{justify-self:end}
  .project-cu-boulder .kwf-snow-row{width:100%;margin-inline:auto;grid-template-columns:minmax(0,.85fr) minmax(340px,1.15fr)}
  .project-cu-boulder .second-media{width:min(100%,752px);height:auto;aspect-ratio:1815/867;justify-self:center}
  .kwf-introduction{width:100%;max-width:1320px;margin:28px auto 18px;text-align:center;font-size:clamp(16px,1.4vw,21px);line-height:1.6;color:var(--ink)}
  .project-cu-boulder .kwf-mesh-row{width:100%;margin-inline:auto;border-top:1px solid var(--line);grid-template-columns:minmax(0,1fr) minmax(0,.95fr) minmax(0,.9fr);gap:28px}
  .kwf-mesh-image{margin:0;justify-self:center;width:100%}
  .kwf-mesh-image:last-child{position:relative;top:-4px}
  .kwf-mesh-image:last-child img{transform:scale(1.06)}
  .kwf-mesh-image img{display:block;width:100%;height:500px;object-fit:contain;mix-blend-mode:lighten}
  .kwf-internship-title{margin:48px 0 24px;text-align:center;font:400 clamp(30px,3vw,44px)/1.1 "Instrument Serif",serif;letter-spacing:-.04em;color:var(--ink)}
  .analysis-number{transform:translateX(-8px);align-self:center;text-align:center;color:var(--teal);font-size:34px}
  .analysis-logos{width:100%;justify-self:start;display:grid}
  .analysis-logos>div{min-height:144px;display:grid;grid-template-columns:26px minmax(90px,1fr) minmax(0,1.2fr);align-items:center;gap:18px;padding:24px 0}
  .analysis-logos>div+div{border-top:1px solid var(--line)}
  .analysis-logos p{margin:0;color:var(--ink);font-size:clamp(16px,1.3vw,20px);line-height:1.6}
  .analysis-logos img{display:block;width:100%;max-width:360px;max-height:96px;object-fit:contain}
  .analysis-logos>div:nth-child(2) img{filter:brightness(0) invert(1);max-width:330px}
  .dimensioned-media{position:relative}
  .project-cu-boulder .dimensioned-media{background:transparent;border:0}
  .project-cu-boulder .dimensioned-media>img{mix-blend-mode:lighten}
  .snow-leopard-reveal{position:relative;width:100vw;height:clamp(195px,24.7svh,305.5px);margin:clamp(12px,2vw,28px) 0 clamp(12px,2vw,28px) calc(50% - 50vw);overflow:hidden;background:#e8ecec}
  .snow-leopard-reveal-frame{width:100%;height:100%;background-image:url("/images/kashmir-snow-leopard-mountain.jpg");background-position:center bottom;background-size:100% auto;background-attachment:fixed;background-repeat:no-repeat}
  .project-project-04 .project-row:first-child{grid-template-columns:minmax(0,.95fr) minmax(340px,1.05fr);transform:translateY(6px)}
  .project-project-04 .project-content{padding-bottom:12px}
  .project-project-04 .project-row:first-child .project-media{width:78%;height:clamp(215px,24vw,325px);justify-self:center}
  .project-project-04 .project-row:first-child .project-media img{transform:none}
  .dbf-story{display:grid;gap:32px;padding:4px 0 28px}
  .dbf-year-section{display:grid;gap:24px;padding-top:20px;border-top:1px solid rgba(167,170,160,.38)}
  .dbf-year-title{margin:0;text-align:center;color:var(--ink);font:600 clamp(22px,2.2vw,30px)/1 "DM Sans",sans-serif}
  .dbf-pair{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;align-items:center}
  .dbf-copy p{margin:0;color:var(--ink);font-size:clamp(16px,1.35vw,20px);line-height:1.62}
  .dbf-copy p+p{margin-top:16px}
  .year-card{margin:0}.year-image{text-align:center}.year-image img{display:block;width:100%;aspect-ratio:16/9;object-fit:cover;background:#303030;border:1px solid var(--line)}
  .team-feature{margin:0;overflow:hidden;background:#222925}.team-feature img{display:block;width:100%;aspect-ratio:16/9;object-fit:cover;object-position:var(--second-position)}
  .dbf-testimonial{width:min(900px,100%);margin:28px auto 0;padding:clamp(26px,4vw,48px);border-top:1px solid rgba(167,170,160,.38);border-bottom:1px solid rgba(167,170,160,.38);text-align:center}
  .dbf-testimonial p{margin:0;color:var(--ink);font:400 clamp(19px,2vw,27px)/1.55 "Instrument Serif",serif}
  .dbf-testimonial p+p{margin-top:18px}
  .dbf-testimonial footer{margin-top:22px;color:var(--teal);font-size:14px;font-weight:600;letter-spacing:.04em}
  .back-to-projects{display:block;width:max-content;margin:0 auto;padding:12px 22px;border:1px solid var(--teal);color:var(--teal);font-size:14px;font-weight:600;transition:background .2s ease,color .2s ease}
  .project-project-04 .back-to-projects{transform:translateY(2px)}
  .back-to-projects:hover{background:var(--teal);color:var(--bg)}
  .site-footer{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:28px clamp(24px,4vw,72px);background:#080a09;color:var(--muted);font-size:11px}
  .site-footer .footer-socials{display:flex;grid-column:2;gap:28px;font-size:16px}.site-footer .footer-socials a{display:inline-flex;align-items:center;gap:9px}.site-footer p{grid-column:3;justify-self:end;margin:0}.footer-linkedin-logo{display:grid;place-items:center;width:23px;height:23px;background:#0a66c2;color:#fff;font:700 15px/1 "DM Sans",sans-serif;letter-spacing:-.08em}

  @media(min-width:721px) and (max-width:1000px){.project-cu-boulder .kwf-mesh-row{grid-template-columns:1.05fr 1.1fr}.kwf-mesh-row .project-copy{grid-column:1/-1}.kwf-mesh-image img{height:440px}}
  @media(max-width:720px){
    .project-cu-boulder .kwf-mesh-row{grid-template-columns:1fr}.kwf-mesh-image{max-width:400px}.kwf-mesh-image img{height:auto;max-height:500px}
    .site-header{height:68px;padding:0 18px}.brand-mark{width:34px;height:32px}.brand-mark b,.brand-mark i{top:7px}.brand-mark b{left:5px}.brand-mark i{left:15px}.site-header nav{gap:10px;font-size:11px}
    .project-hero{height:clamp(260px,38svh,360px)}h1{font-size:clamp(42px,13vw,65px)}
    .project-content{width:min(100% - 36px,620px);padding:8px 0 34px}.project-row,.project-cu-boulder .kwf-aircraft-row,.project-cu-boulder .kwf-snow-row{grid-template-columns:1fr;gap:22px;padding:30px 0}.project-row:first-child{padding-top:18px}.project-media{height:240px}.project-project-04 .project-row:first-child{grid-template-columns:1fr}.project-project-04 .project-row:first-child .project-media{width:86%;height:220px}.dbf-story{gap:28px;padding-top:10px}.dbf-year-section{gap:18px;padding-top:18px}.dbf-pair{grid-template-columns:1fr;gap:18px}
    .snow-leopard-reveal{height:clamp(169px,24.7svh,234px);margin-top:8px;margin-bottom:8px}
    .site-footer{grid-template-columns:1fr;gap:14px;text-align:center}.site-footer .footer-socials,.site-footer p{grid-column:1;justify-self:center}.site-footer .footer-socials{gap:18px;font-size:13px}.footer-linkedin-logo{width:20px;height:20px;font-size:13px}
  }

</style>
