  :root{--bg:#0d0f0e;--ink:#f2f0e8;--line:rgba(242,240,232,.18);--teal:#5be5cf}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:"DM Sans",sans-serif}a{color:inherit;text-decoration:none}header{height:74px;display:grid;grid-template-columns:1fr auto;align-items:center;padding:0 clamp(20px,4vw,72px);border-bottom:1px solid var(--line)}.brand{display:flex;align-items:center}.brand span{position:relative;display:block;width:43px;height:40px;overflow:hidden;background:#0d0f0e;border:1px solid var(--teal)}.brand b,.brand i{position:absolute;top:10px;color:#e9faf5;font:800 17px/1 "DM Sans",sans-serif;font-style:normal;text-shadow:1px 1px 0 #126e67,2px 2px 0 #08453d,3px 3px 4px rgba(0,0,0,.5)}.brand b{left:8px}.brand i{left:20px}nav{display:flex;gap:clamp(15px,2.3vw,30px);font-size:12px}nav a:hover,nav a[aria-current="page"]{color:var(--teal)}main{max-width:1200px;margin:auto;padding:55px clamp(24px,7vw,100px)}.resume-image{display:block;width:100%;height:auto;border:1px solid var(--line);background:#fff}.resume-actions{display:flex;justify-content:center;gap:16px;margin:28px auto 0}.home-button,.download{display:flex;align-items:center;justify-content:center;min-width:142px;padding:17px 24px;border:1px solid var(--line);font-size:15px;font-weight:600}.home-button:hover,.download:hover{background:var(--ink);color:var(--bg)}@media(max-width:600px){header{height:68px}nav{gap:10px;font-size:10px}.brand span{width:38px;height:36px}.brand b,.brand i{top:8px}.brand b{left:7px}.brand i{left:18px}main{padding:35px 18px}.resume-actions{gap:10px}.home-button,.download{min-width:0;padding:14px 16px;font-size:13px}}
  /* Keep the monogram and navigation in lockstep with the rest of the site. */
  .brand span { width: 36px; height: 34px; }
  .brand b, .brand i { top: 8px; }
  .brand b { left: 6px; }
