---
import PortfolioFooter from "../components/PortfolioFooter.astro";
import PortfolioHeader from "../components/PortfolioHeader.astro";
import CloudflareAnalytics from "../components/CloudflareAnalytics.astro";
import "../styles/portfolio.css";
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Projects | Ryan Cross</title><link rel="icon" href="/favicon.svg"/></head><body class=""><PortfolioHeader active="projects"/><main class="portfolio-main"><section class="intro"><div class="intro-copy"><h1>I'm an <strong>aerospace engineer.</strong></h1><p class="degree"><img class="cu-logo" src="/images/cu-boulder-logo.svg" alt="CU Boulder"/><span>Masters in Aerospace Engineering</span></p></div><div class="portrait"><img src="/images/home-ryan-flowers-current.jpg" alt="Portrait of Ryan Cross"/></div><div class="flatirons-horizon" aria-hidden="true"><img src="/images/flatirons-landscape-v2.png" alt=""/></div></section><section class="projects-section" id="projects" aria-label="Selected engineering projects"><h2 class="projects-title">projects</h2><div class="grid">
<a class="card" href="/projects/sierra-space"><div class="photo"><img src="/images/sierra-space-icon.png" alt="Sierra Space Dream Chaser spacecraft" loading="lazy"></div><div class="caption"><div><h2>Sierra Space</h2><p>Systems Engineering Intern</p></div><span class="arrow" aria-hidden="true">↗</span></div></a>
<a class="card" href="/projects/kashmir-world-foundation"><div class="photo"><img src="/images/kashmir-aircraft-concept.png" alt="Kashmir World Foundation aerodynamic simulation"></div><div class="caption"><div><h2>Kashmir World Foundation</h2><p>Aerodynamics Intern</p></div><span class="arrow" aria-hidden="true">↗</span></div></a>
<a class="card" href="/projects/design-build-fly"><div class="photo"><img src="/images/design-build-fly-01.webp" alt="CU Boulder Design Build Fly aircraft flying in the sky"></div><div class="caption"><div><h2>Design Build Fly</h2><p>Propulsion Lead</p></div><span class="arrow" aria-hidden="true">↗</span></div></a>
<a class="card" href="/projects/kairos-power"><div class="photo"><img src="/images/kairos-power-icon.png" alt="Kairos Power reactor test facility" loading="lazy"></div><div class="caption"><div><h2>Kairos Power</h2><p>Test Engineering Intern</p></div><span class="arrow" aria-hidden="true">↗</span></div></a>
</div></section></main><PortfolioFooter blue/><CloudflareAnalytics/></body></html>
