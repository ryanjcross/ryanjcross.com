---
const projects = [
  { number: "01", title: "Stampede Sky", eyebrow: "Senior Design · Propulsion", summary: "Propulsion and integrated test work for a CU Boulder aerospace senior design team.", href: "/projects/stampede-sky", accent: "teal" },
  { number: "02", title: "Kairos Power", eyebrow: "Industry · Test Engineering", summary: "A test engineering internship supporting advanced nuclear technology development.", href: "/projects/kairos-power", accent: "blue" },
  { number: "03", title: "CU Boulder", eyebrow: "Education · Aerospace Engineering", summary: "Aerospace engineering studies grounded in systems thinking and hands-on learning.", href: "/projects/cu-boulder", accent: "gold" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Ryan Cross — aerospace engineering, propulsion, and test engineering." />
    <link rel="icon" href="/favicon.svg" />
    <title>Ryan Cross | Aerospace Engineering</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#top" aria-label="Ryan Cross, home"><span>RC</span> Ryan Cross</a>
      <nav aria-label="Primary navigation"><a href="#about">About</a><a href="#work">Work</a><a href="#contact">Connect</a></nav>
      <div class="header-contact"><a href="tel:+17206465242">720-646-5242</a><a href="mailto:ryanc31415@gmail.com">ryanc31415@gmail.com</a></div>
    </header>

    <main id="top">
      <section class="hero section">
        <div class="art art-one" aria-hidden="true"></div><div class="art art-two" aria-hidden="true"></div>
        <div class="hero-copy"><p class="eyebrow">Aerospace Engineer · Boulder, Colorado</p><h1>Build it.<br /><em>Test it.</em><br />Learn fast.</h1><p>I’m Ryan Cross, an aerospace engineering student at CU Boulder with experience in propulsion, integrated test, and systems engineering.</p><a class="button" href="#work">Explore my work <span>↓</span></a></div>
        <div class="portrait hero-portrait" role="img" aria-label="Space for a portrait of Ryan Cross"><span>Your portrait</span></div>
      </section>

      <section class="about section" id="about">
        <div class="portrait about-portrait" role="img" aria-label="Space for a photo of Ryan Cross"><span>About photo</span></div>
        <div class="about-copy"><p class="eyebrow">/ About me</p><h2>Curious by default.<br /><em>Rigorous by practice.</em></h2><p>I’m completing my aerospace engineering degree at the University of Colorado Boulder. My experience includes propulsion and integrated test work on Stampede Sky and a test engineering internship at Kairos Power.</p><p>Different domains, same motivation: understand the system, ask the useful question, and build evidence strong enough to move forward.</p><div class="education"><span>Education</span><strong>University of Colorado Boulder</strong><small>Aerospace Engineering · 2022–2026</small></div></div>
      </section>

      <section class="work section" id="work"><div class="section-intro"><p class="eyebrow">/ Selected work</p><h2>Ideas under<br /><em>real-world pressure.</em></h2><p>Open a project for a focused, one-screen overview.</p></div><div class="project-list">{projects.map((project) => (<a class={`project-card ${project.accent}`} href={project.href}><span class="project-number">{project.number}</span><div class="project-art" aria-hidden="true"></div><div><p class="eyebrow">{project.eyebrow}</p><h3>{project.title}</h3><p>{project.summary}</p></div><span class="arrow" aria-hidden="true">→</span></a>))}</div></section>

      <section class="contact section" id="contact"><div class="contact-art" aria-hidden="true"></div><p class="eyebrow">/ Let’s connect</p><h2>Have a hard problem<br />worth <em>testing?</em></h2><div class="contact-links"><a href="mailto:ryanc31415@gmail.com">ryanc31415@gmail.com <span>↗</span></a><a href="tel:+17206465242">720-646-5242 <span>↗</span></a><a href="https://www.linkedin.com/in/ryan-cross-/" target="_blank" rel="noreferrer">LinkedIn <span>↗</span></a><a href="https://github.com/ryanjcross" target="_blank" rel="noreferrer">GitHub <span>↗</span></a></div></section>
    </main>
    <footer><a class="brand" href="#top"><span>RC</span> Ryan Cross</a><p>© {new Date().getFullYear()} Ryan Cross</p></footer>
  </body>
</html>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap");
  :root { --bg:#0e100f; --surface:#171a18; --soft:#222722; --ink:#f2f0e8; --muted:#a7aaa0; --line:rgba(242,240,232,.18); --teal:#6be6d3; --blue:#8ca7ff; --gold:#f1cc58; } *{box-sizing:border-box} html{scroll-behavior:smooth;background:var(--bg)} body{margin:0;background:var(--bg);color:var(--ink);font-family:"DM Sans",sans-serif} a{color:inherit;text-decoration:none} .site-header{position:fixed;z-index:10;top:0;width:100%;height:76px;padding:0 clamp(20px,4vw,70px);display:grid;grid-template-columns:1fr auto 1fr;align-items:center;background:rgba(14,16,15,.83);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}.brand{display:flex;align-items:center;gap:10px;font-size:14px;font-weight:600}.brand span{display:grid;place-items:center;width:32px;height:32px;border:1px solid currentColor;border-radius:50%;font-size:10px}.site-header nav{display:flex;gap:28px;font-size:12px}.site-header nav a:hover,.header-contact a:hover{color:var(--teal)}.header-contact{justify-self:end;display:flex;gap:18px;font-size:11px}.header-contact a{border-bottom:1px solid var(--line);padding-bottom:3px}.section{position:relative;padding:clamp(100px,13vw,170px) clamp(24px,8vw,130px);overflow:hidden}.eyebrow{margin:0 0 22px;color:var(--muted);font-size:10px;font-weight:600;letter-spacing:.15em;text-transform:uppercase}h1,h2,h3{margin:0;font-family:"Instrument Serif",serif;font-weight:400;letter-spacing:-.055em}h1{font-size:clamp(76px,11vw,160px);line-height:.77}h2{font-size:clamp(62px,8vw,115px);line-height:.82}h1 em,h2 em{color:var(--teal)}.hero{min-height:100svh;display:grid;grid-template-columns:minmax(0,1fr) minmax(270px,.65fr);gap:70px;align-items:center}.hero-copy{position:relative;z-index:1;max-width:750px}.hero-copy>p:not(.eyebrow){max-width:500px;margin:40px 0;color:var(--muted);font-size:18px;line-height:1.65}.button{display:inline-flex;gap:36px;padding:16px 20px;background:var(--ink);color:var(--bg);font-size:12px;font-weight:600;transition:transform .2s}.button:hover{transform:translateY(-4px)}.portrait{position:relative;display:grid;place-items:center;min-height:390px;background:linear-gradient(145deg,#2b342f,#151a17);border:1px solid var(--line);overflow:hidden}.portrait::before,.portrait::after{content:"";position:absolute;border:1px solid rgba(107,230,211,.5);border-radius:50%}.portrait::before{width:75%;aspect-ratio:1}.portrait::after{width:45%;aspect-ratio:1;border-color:rgba(140,167,255,.65)}.portrait span{z-index:1;padding:9px 13px;border:1px solid var(--line);background:#111411cc;font-size:10px;letter-spacing:.14em;text-transform:uppercase}.hero-portrait{transform:rotate(3deg)}.art{position:absolute;border-radius:50%;filter:blur(2px);opacity:.8}.art-one{width:310px;height:310px;right:23%;top:16%;background:radial-gradient(circle at 35% 35%,var(--blue),transparent 65%)}.art-two{width:460px;height:180px;left:-150px;bottom:4%;background:var(--teal);transform:rotate(-25deg);filter:blur(80px);opacity:.16}.about{display:grid;grid-template-columns:minmax(280px,.8fr) minmax(0,1.2fr);gap:clamp(45px,9vw,150px);align-items:center;background:var(--surface)}.about-portrait{min-height:540px;transform:rotate(-2deg)}.about-copy>p:not(.eyebrow){max-width:650px;color:var(--muted);font-size:18px;line-height:1.7}.education{display:grid;grid-template-columns:135px 1fr;gap:8px;margin-top:45px;padding-top:22px;border-top:1px solid var(--line)}.education span,.education small{color:var(--muted);font-size:11px}.education strong{font-family:"Instrument Serif",serif;font-size:25px;font-weight:400}.education small{grid-column:2}.work{background:#111411}.section-intro{display:grid;grid-template-columns:1fr 1fr;gap:35px;align-items:end;margin-bottom:68px}.section-intro>p:last-child{max-width:280px;color:var(--muted);font-size:14px;line-height:1.7}.project-list{border-top:1px solid var(--line)}.project-card{display:grid;grid-template-columns:48px 250px minmax(0,1fr) 28px;gap:clamp(20px,4vw,64px);align-items:center;min-height:260px;padding:25px 0;border-bottom:1px solid var(--line);transition:background .2s}.project-card:hover{background:#1a201c}.project-number{align-self:start;font:11px monospace;color:var(--muted)}.project-art{height:190px;background:#26312c;position:relative;overflow:hidden}.project-art::before{content:"";position:absolute;width:94px;height:94px;top:50%;left:50%;transform:translate(-50%,-50%);border:25px solid var(--teal);border-radius:50%}.blue .project-art::before{border:0;border-radius:0;background:var(--blue);transform:translate(-50%,-50%) rotate(45deg)}.gold .project-art::before{width:130px;height:75px;border:0;border-radius:100% 0;background:var(--gold);transform:translate(-50%,-50%) rotate(-25deg)}.project-card h3{margin:0 0 12px;font-size:clamp(34px,4vw,54px)}.project-card div>p:last-child{margin:0;color:var(--muted);font-size:14px;line-height:1.6}.arrow{font-size:22px}.contact{min-height:720px;background:var(--teal);color:#0e100f;display:flex;flex-direction:column;justify-content:center}.contact .eyebrow{color:#33403a}.contact h2 em{color:#f4f1e7}.contact-links{position:relative;z-index:1;display:grid;grid-template-columns:repeat(2,minmax(0,310px));gap:12px;margin-top:45px}.contact-links a{display:flex;justify-content:space-between;padding:13px 0;border-bottom:1px solid rgba(14,16,15,.4);font-size:14px}.contact-links a:hover{padding-left:8px}.contact-art{position:absolute;width:650px;height:650px;right:-100px;top:35px;border:1px solid rgba(14,16,15,.35);border-radius:50%}.contact-art::before,.contact-art::after{content:"";position:absolute;border:1px solid rgba(14,16,15,.3);border-radius:50%}.contact-art::before{inset:90px}.contact-art::after{inset:190px;background:rgba(14,16,15,.08)}footer{display:flex;justify-content:space-between;align-items:center;padding:28px clamp(24px,4vw,70px);background:#090b0a;color:var(--muted);font-size:11px}@media(max-width:850px){.site-header{grid-template-columns:1fr auto;height:70px}.site-header nav{display:none}.header-contact{gap:12px;font-size:10px}.hero,.about{grid-template-columns:1fr}.hero{padding-top:125px;gap:45px}.hero-portrait{min-height:320px}.about-portrait{min-height:350px}.section-intro{grid-template-columns:1fr}.project-card{grid-template-columns:34px 1fr 24px;gap:16px}.project-art{grid-column:2/4;height:180px}.project-card>div:nth-child(3){grid-column:2/4}.arrow{grid-column:3;grid-row:1}.contact-links{grid-template-columns:1fr}.contact-art{opacity:.35;right:-420px}.education{grid-template-columns:1fr}.education small{grid-column:1}}@media(max-width:520px){.header-contact a:first-child{display:none}.header-contact{font-size:10px}.section{padding-left:22px;padding-right:22px}.hero-copy>p:not(.eyebrow){font-size:16px}.about-copy>p:not(.eyebrow){font-size:16px}}
</style>
