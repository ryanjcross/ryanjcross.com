---
const projects = [
  {
    number: "01",
    eyebrow: "Senior Design · Propulsion",
    title: "Stampede Sky",
    summary:
      "Propulsion and integrated test work for a CU Boulder aerospace senior design team, connecting subsystem decisions with full vehicle evaluation.",
    tags: ["Propulsion", "Integrated Test", "Systems Engineering"],
    href: "https://www.colorado.edu/aerospace/academics/undergraduates/senior-design-projects/2025-2026/stampede-sky",
    accent: "teal",
  },
  {
    number: "02",
    eyebrow: "Industry · Test Engineering",
    title: "Kairos Power",
    summary:
      "A test engineering internship supporting the work of an engineering company developing advanced nuclear technology.",
    tags: ["Test Engineering", "Engineering", "Nuclear Technology"],
    href: "https://www.kairospower.com/",
    accent: "blue",
  },
  {
    number: "03",
    eyebrow: "Education · Aerospace Engineering",
    title: "CU Boulder",
    summary:
      "Aerospace engineering studies at the University of Colorado Boulder, with graduation expected in 2026.",
    tags: ["Aerospace Engineering", "Class of 2026", "Boulder"],
    href: "https://www.colorado.edu/aerospace/",
    accent: "yellow",
  },
];

const capabilities = [
  ["01", "Test", "Designing practical ways to learn from real hardware."],
  ["02", "Analyze", "Turning messy results into useful engineering decisions."],
  ["03", "Integrate", "Keeping subsystem work connected to the full mission."],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Ryan Cross is an aerospace engineering student at CU Boulder with experience in propulsion and test engineering."
    />
    <meta property="og:title" content="Ryan Cross | Aerospace Engineering" />
    <meta
      property="og:description"
      content="Aerospace engineering, propulsion, and test engineering."
    />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#f0eee8" />
    <link rel="icon" href="/favicon.svg" />
    <title>Ryan Cross | Aerospace Engineering</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#top" aria-label="Ryan Cross, home">
        <span class="brand-mark">RC</span>
        <span class="brand-text">Ryan Cross</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="#work">Work</a>
        <a href="#about">About</a>
        <a class="nav-cta" href="https://www.linkedin.com/in/ryan-cross-/" target="_blank" rel="noreferrer">
          LinkedIn <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="hero-kicker"><span></span> Aerospace engineer · Boulder, CO</div>
        <h1 id="hero-title">
          Build it.<br />
          <em>Test it.</em><br />
          Learn fast.
        </h1>
        <p class="hero-copy">
          I’m Ryan. I’m an aerospace engineering student at CU Boulder with experience
          in propulsion and test engineering.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#work">Explore my work <span aria-hidden="true">↓</span></a>
          <a class="text-link" href="https://www.linkedin.com/in/ryan-cross-/" target="_blank" rel="noreferrer">
            Connect on LinkedIn <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="orbit-diagram" aria-hidden="true">
          <div class="orbit orbit-one"></div>
          <div class="orbit orbit-two"></div>
          <div class="orbit-core">RC</div>
          <span class="point point-a"></span>
          <span class="point point-b"></span>
          <div class="coordinate">40.0150° N<br />105.2705° W</div>
        </div>
        <div class="scroll-note" aria-hidden="true">Scroll to explore <span>↓</span></div>
      </section>

      <section class="manifesto">
        <p class="section-label">/ Approach</p>
        <p class="manifesto-copy">
          The best engineering happens when <strong>analysis</strong> and
          <strong>hands-on testing</strong> keep each other honest.
        </p>
        <div class="capabilities">
          {capabilities.map(([number, title, description]) => (
            <article>
              <span>{number}</span>
              <h2>{title}</h2>
              <p>{description}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="work-section" id="work" aria-labelledby="work-title">
        <div class="section-heading">
          <div>
            <p class="section-label">/ Selected work</p>
            <h2 id="work-title">Ideas under<br /><em>real-world pressure.</em></h2>
          </div>
          <p>Projects and experiences where testing, systems thinking, and curiosity converge.</p>
        </div>

        <div class="project-list">
          {projects.map((project) => (
            <a class={`project-card ${project.accent}`} href={project.href} target="_blank" rel="noreferrer">
              <div class="project-number">{project.number}</div>
              <div class="project-graphic" aria-hidden="true">
                <div class="project-shape"></div>
                <div class="project-lines"></div>
              </div>
              <div class="project-content">
                <p class="project-eyebrow">{project.eyebrow}</p>
                <h3>{project.title}</h3>
                <p>{project.summary}</p>
                <ul aria-label="Project disciplines">
                  {project.tags.map((tag) => <li>{tag}</li>)}
                </ul>
              </div>
              <span class="project-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </section>

      <section class="about-section" id="about" aria-labelledby="about-title">
        <div class="about-sidebar">
          <p class="section-label">/ About</p>
          <div class="status"><span></span> Open to interesting conversations</div>
        </div>
        <div class="about-copy">
          <h2 id="about-title">Curious by default.<br /><em>Rigorous by practice.</em></h2>
          <p>
            I’m completing my aerospace engineering degree at the University of
            Colorado Boulder. My experience includes propulsion and integrated test
            work on Stampede Sky and a test engineering internship at Kairos Power.
          </p>
          <p>
            Different domains, same motivation: understand the system, ask the useful
            question, and build evidence strong enough to move forward.
          </p>
          <div class="education">
            <span>Education</span>
            <div>
              <strong>University of Colorado Boulder</strong>
              <p>Aerospace Engineering · 2022–2026</p>
            </div>
          </div>
        </div>
      </section>

      <section class="contact-section">
        <p class="section-label">/ Let’s connect</p>
        <h2>Have a hard problem<br />worth <em>testing?</em></h2>
        <a class="button button-light" href="https://www.linkedin.com/in/ryan-cross-/" target="_blank" rel="noreferrer">
          Start a conversation <span aria-hidden="true">↗</span>
        </a>
        <div class="contact-rings" aria-hidden="true"></div>
      </section>
    </main>

    <footer>
      <a class="brand footer-brand" href="#top">
        <span class="brand-mark">RC</span>
        <span class="brand-text">Ryan Cross</span>
      </a>
      <p>Engineering for the world beyond the whiteboard.</p>
      <p>© {new Date().getFullYear()} Ryan Cross</p>
    </footer>
    <script>
      const observer = new IntersectionObserver(
        (entries) => entries.forEach((entry) => entry.target.classList.toggle("in-view", entry.isIntersecting)),
        { threshold: 0.12 },
      );
      document.querySelectorAll(".project-card, .capabilities article, .about-copy").forEach((el) => observer.observe(el));
    </script>
  </body>
</html>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap");

  :root {
    --paper: #f0eee8;
    --ink: #171914;
    --muted: #686b61;
    --line: #c9c8bf;
    --teal: #126e67;
    --blue: #5e80ff;
    --yellow: #ebc83e;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; background: var(--paper); }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: "DM Sans", sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-decoration: none; }
  ::selection { background: var(--yellow); color: var(--ink); }

  .site-header {
    position: absolute;
    z-index: 10;
    inset: 0 0 auto;
    height: 94px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 clamp(24px, 5vw, 76px);
    border-bottom: 1px solid rgba(23,25,20,.18);
  }
  .brand { display: inline-flex; align-items: center; gap: 12px; font-weight: 600; }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 37px;
    height: 37px;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    font-size: 12px;
    letter-spacing: -.04em;
  }
  .site-header nav { display: flex; align-items: center; gap: clamp(20px, 3vw, 46px); font-size: 14px; }
  .site-header nav a { transition: opacity .2s; }
  .site-header nav a:hover { opacity: .58; }
  .nav-cta { border-bottom: 1px solid currentColor; padding-bottom: 4px; }

  .hero {
    position: relative;
    min-height: min(920px, 100svh);
    overflow: hidden;
    padding: clamp(150px, 16vh, 190px) clamp(24px, 8vw, 130px) 80px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .hero-grid {
    position: absolute;
    inset: 0;
    opacity: .32;
    background-image: linear-gradient(rgba(23,25,20,.09) 1px, transparent 1px), linear-gradient(90deg, rgba(23,25,20,.09) 1px, transparent 1px);
    background-size: 55px 55px;
    mask-image: linear-gradient(to right, black, transparent 75%);
  }
  .hero-kicker, .section-label {
    position: relative;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .16em;
  }
  .hero-kicker { display: flex; align-items: center; gap: 10px; margin-bottom: 28px; }
  .hero-kicker span, .status span { width: 7px; height: 7px; background: var(--teal); border-radius: 50%; }
  h1, .section-heading h2, .about-copy h2, .contact-section h2 {
    position: relative;
    margin: 0;
    font-family: "Instrument Serif", serif;
    font-size: clamp(74px, 11vw, 158px);
    font-weight: 400;
    letter-spacing: -.055em;
    line-height: .76;
  }
  h1 em, h2 em { color: var(--teal); font-weight: 400; }
  .hero-copy {
    position: relative;
    max-width: 490px;
    margin: 38px 0 0 38%;
    color: #454840;
    font-size: clamp(16px, 1.4vw, 20px);
    line-height: 1.6;
  }
  .hero-actions { position: relative; display: flex; align-items: center; gap: 32px; margin: 34px 0 0 38%; }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    min-width: 190px;
    gap: 25px;
    padding: 16px 20px;
    font-size: 13px;
    font-weight: 600;
    transition: transform .25s, background .25s;
  }
  .button:hover { transform: translateY(-3px); }
  .button-primary { background: var(--ink); color: white; }
  .text-link { font-size: 13px; border-bottom: 1px solid currentColor; padding: 5px 0; }
  .orbit-diagram { position: absolute; width: 420px; height: 420px; right: -65px; top: 19%; }
  .orbit { position: absolute; inset: 0; border: 1px solid rgba(23,25,20,.25); border-radius: 50%; }
  .orbit-two { inset: 80px; }
  .orbit-core {
    position: absolute; inset: 150px; display: grid; place-items: center;
    color: white; background: var(--teal); border-radius: 50%; font-weight: 600;
  }
  .orbit-one::before, .orbit-one::after { content: ""; position: absolute; background: rgba(23,25,20,.22); }
  .orbit-one::before { height: 1px; width: 520px; top: 50%; left: -50px; }
  .orbit-one::after { width: 1px; height: 520px; left: 50%; top: -50px; }
  .point { position: absolute; width: 10px; height: 10px; background: var(--ink); border-radius: 50%; }
  .point-a { top: 55px; left: 62px; }
  .point-b { right: 15px; bottom: 130px; background: var(--blue); }
  .coordinate { position: absolute; right: 25px; top: 80px; font: 10px/1.5 monospace; }
  .scroll-note { position: absolute; right: 74px; bottom: 38px; font-size: 10px; text-transform: uppercase; letter-spacing: .12em; }
  .scroll-note span { margin-left: 14px; }

  .manifesto { padding: 115px clamp(24px, 8vw, 130px); background: var(--ink); color: white; }
  .manifesto .section-label { color: #aaa; }
  .manifesto-copy { max-width: 1090px; margin: 55px 0 85px; font-family: "Instrument Serif", serif; font-size: clamp(43px, 6.4vw, 94px); line-height: .98; letter-spacing: -.035em; }
  .manifesto-copy strong { color: var(--yellow); font-weight: 400; }
  .manifesto-copy strong:last-child { color: var(--blue); }
  .capabilities { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid #4a4c46; }
  .capabilities article { padding: 28px 36px 10px 0; border-right: 1px solid #4a4c46; opacity: .35; transform: translateY(15px); transition: .55s; }
  .capabilities article.in-view { opacity: 1; transform: none; }
  .capabilities article + article { padding-left: 36px; }
  .capabilities article:last-child { border: 0; }
  .capabilities span { color: #8d9088; font: 11px monospace; }
  .capabilities h2 { margin: 50px 0 13px; font: 400 34px "Instrument Serif", serif; }
  .capabilities p { max-width: 240px; color: #aaa; font-size: 13px; line-height: 1.6; }

  .work-section { padding: 130px clamp(24px, 6vw, 96px); }
  .section-heading { display: flex; justify-content: space-between; align-items: flex-end; margin: 0 auto 70px; max-width: 1280px; }
  .section-heading h2, .about-copy h2 { font-size: clamp(58px, 7vw, 102px); line-height: .9; margin-top: 25px; }
  .section-heading > p { max-width: 320px; color: var(--muted); font-size: 14px; line-height: 1.7; }
  .project-list { max-width: 1280px; margin: auto; border-top: 1px solid var(--line); }
  .project-card {
    position: relative;
    display: grid;
    grid-template-columns: 70px minmax(180px, 330px) 1fr 40px;
    gap: clamp(20px, 4vw, 65px);
    align-items: center;
    min-height: 320px;
    padding: 38px 0;
    border-bottom: 1px solid var(--line);
    opacity: .2;
    transform: translateY(22px);
    transition: opacity .6s, transform .6s;
  }
  .project-card.in-view { opacity: 1; transform: none; }
  .project-number { align-self: start; font: 11px monospace; }
  .project-graphic { position: relative; height: 240px; overflow: hidden; background: #dddcd5; }
  .project-shape { position: absolute; width: 140px; height: 140px; border-radius: 50%; top: 50%; left: 50%; transform: translate(-50%,-50%); border: 35px solid var(--teal); }
  .blue .project-shape { border-radius: 0; border: 0; background: var(--blue); transform: translate(-50%,-50%) rotate(45deg); }
  .yellow .project-shape { border: 0; width: 180px; height: 100px; border-radius: 100% 0; background: var(--yellow); transform: translate(-50%,-50%) rotate(-25deg); }
  .project-lines { position: absolute; inset: 0; background: repeating-linear-gradient(90deg, transparent 0 32px, rgba(23,25,20,.14) 33px 34px); mix-blend-mode: multiply; }
  .project-content { max-width: 580px; }
  .project-eyebrow { margin: 0 0 16px; color: var(--muted); font-size: 10px !important; text-transform: uppercase; letter-spacing: .13em; }
  .project-content h3 { margin: 0 0 14px; font: 400 clamp(34px, 4vw, 60px) "Instrument Serif", serif; letter-spacing: -.03em; }
  .project-content > p { color: var(--muted); font-size: 14px; line-height: 1.7; }
  .project-content ul { display: flex; flex-wrap: wrap; gap: 8px; padding: 0; margin: 22px 0 0; list-style: none; }
  .project-content li { padding: 6px 9px; border: 1px solid var(--line); font-size: 9px; text-transform: uppercase; letter-spacing: .08em; }
  .project-arrow { align-self: start; font-size: 23px; transition: transform .25s; }
  .project-card:hover .project-arrow { transform: translate(5px,-5px); }
  .project-card:hover .project-graphic { filter: saturate(1.2); }

  .about-section { display: grid; grid-template-columns: 1fr 2fr; gap: 60px; padding: 130px clamp(24px, 8vw, 130px); background: #dbd9d1; }
  .about-sidebar { display: flex; flex-direction: column; justify-content: space-between; }
  .status { display: flex; align-items: center; gap: 9px; color: var(--muted); font-size: 11px; }
  .status span { display: block; background: #48a15e; }
  .about-copy { max-width: 790px; opacity: .3; transform: translateY(18px); transition: .6s; }
  .about-copy.in-view { opacity: 1; transform: none; }
  .about-copy > p { max-width: 680px; color: #4e5149; font-size: clamp(17px, 1.55vw, 22px); line-height: 1.65; }
  .education { display: grid; grid-template-columns: 140px 1fr; margin-top: 65px; padding-top: 25px; border-top: 1px solid #b9b8b0; }
  .education > span { color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: .1em; }
  .education strong { font-family: "Instrument Serif", serif; font-size: 24px; font-weight: 400; }
  .education p { color: var(--muted); font-size: 13px; }

  .contact-section { position: relative; overflow: hidden; min-height: 680px; padding: 100px clamp(24px, 8vw, 130px); color: white; background: var(--teal); display: flex; flex-direction: column; justify-content: center; }
  .contact-section h2 { z-index: 1; font-size: clamp(67px, 9vw, 130px); line-height: .83; margin: 40px 0; }
  .contact-section h2 em { color: var(--ink); }
  .button-light { position: relative; z-index: 1; align-self: flex-start; background: white; color: var(--ink); }
  .contact-rings { position: absolute; width: 620px; height: 620px; right: -100px; top: 30px; border: 1px solid rgba(255,255,255,.35); border-radius: 50%; }
  .contact-rings::before, .contact-rings::after { content: ""; position: absolute; border: 1px solid rgba(255,255,255,.35); border-radius: 50%; }
  .contact-rings::before { inset: 90px; }
  .contact-rings::after { inset: 190px; background: rgba(255,255,255,.08); }

  footer { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 30px; min-height: 120px; padding: 20px clamp(24px, 5vw, 76px); background: var(--ink); color: white; font-size: 11px; }
  footer p:nth-child(2) { color: #95978f; text-align: center; }
  footer p:last-child { text-align: right; color: #95978f; }

  @media (max-width: 900px) {
    .site-header { height: 76px; }
    .site-header nav a:not(.nav-cta) { display: none; }
    .hero { min-height: 850px; justify-content: flex-start; }
    .hero-copy, .hero-actions { margin-left: 0; max-width: 450px; }
    .orbit-diagram { opacity: .38; right: -230px; top: 45%; }
    .scroll-note { display: none; }
    .capabilities { grid-template-columns: 1fr; }
    .capabilities article, .capabilities article + article { padding: 26px 0; border-right: 0; border-bottom: 1px solid #4a4c46; }
    .capabilities h2 { margin-top: 20px; }
    .section-heading { align-items: flex-start; flex-direction: column; gap: 30px; }
    .project-card { grid-template-columns: 38px 1fr 25px; gap: 15px; }
    .project-graphic { grid-column: 2 / 4; width: 100%; }
    .project-content { grid-column: 2 / 4; }
    .project-arrow { grid-column: 3; grid-row: 1; }
    .about-section { grid-template-columns: 1fr; }
    .about-sidebar { gap: 55px; }
    .contact-rings { opacity: .4; right: -380px; }
    footer { grid-template-columns: 1fr 1fr; }
    footer p:nth-child(2) { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }
</style>
